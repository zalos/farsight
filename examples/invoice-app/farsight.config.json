{
  "tests": {
    "unit": {
      "runner": "vitest",
      "results": "coverage/vitest-results.json",
      "coverage": "coverage/coverage-final.json"
    },
    "e2e": {
      "runner": "playwright",
      "results": "e2e/results.json",
      "coverage": "e2e/coverage/coverage-final.json"
    }
  },
  "externals": [
    {
      "import": "src/server/erpClient.ts::ErpClient",
      "name": "Example ERP",
      "kind": "erp"
    }
  ],
  "stores": [
    {
      "name": "Invoice DB",
      "kind": "sql",
      "engine": "postgres"
    }
  ],
  "plumbing": [
    "src/server/plumbing/**"
  ],
  "setup": [
    "src/server/container.ts buildContainer"
  ],
  "storybook": {
    "configDir": ".storybook",
    "url": "http://127.0.0.1:4539",
    "command": "npm run storybook",
    "name": "Invoice app UI"
  },
  "journeys": {
    "flows": [
      {
        "id": "draft-and-send",
        "group": "review"
      }
    ]
  },
  "lifecycle": {
    "invoices": {
      "views": {
        "billing": {
          "Being drafted": [
            "draft"
          ],
          "Sent": [
            "open"
          ],
          "Approved": [
            "approved"
          ],
          "Paid": [
            "paid"
          ],
          "Void (ended)": [
            "void"
          ]
        }
      },
      "overlays": [
        {
          "name": "Posted to the ledger",
          "table": "ledger_entries",
          "when": "a ledger entry names the invoice"
        }
      ]
    }
  }
}
