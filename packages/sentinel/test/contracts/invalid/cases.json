[
  {
    "name": "a future draft of a known envelope is refused with the supported list",
    "base": "run-active",
    "ops": [
      {
        "set": "/schema",
        "value": "sentinel-run/draft-2"
      }
    ],
    "expect": "sentinel.contract.unsupportedVersion",
    "path": "/schema"
  },
  {
    "name": "a frozen v1 name is not accepted by a draft build",
    "base": "report",
    "ops": [
      {
        "set": "/schema",
        "value": "sentinel-report/v1"
      }
    ],
    "expect": "sentinel.contract.unsupportedVersion",
    "path": "/schema"
  },
  {
    "name": "another envelope's version is the wrong kind",
    "base": "run-active",
    "ops": [
      {
        "set": "/schema",
        "value": "sentinel-work/draft-1"
      }
    ],
    "expect": "sentinel.contract.wrongKind",
    "path": "/schema"
  },
  {
    "name": "a missing version is never assumed",
    "base": "snapshot",
    "ops": [
      {
        "delete": "/schema"
      }
    ],
    "expect": "sentinel.contract.missingVersion",
    "path": "/schema"
  },
  {
    "name": "a numeric version is not a version string",
