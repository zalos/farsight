{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/EffectivePolicyEnvelope",
  "definitions": {
    "EffectivePolicyEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-policy/draft-1"
        },
        "settingsTrust": {
          "$ref": "#/definitions/SettingsTrust"
        },
        "settingsDigest": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "hostedReviewSecretScan": {
          "type": "string",
          "enum": [
            "required",
            "when-selected"
          ],
          "description": "Absent means required; the explicit adopted choice never claims secret coverage."
        },
        "repoConfigDigest": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "familyId": {
                "$ref": "#/definitions/RuleFamilyId"
              },
              "source": {
                "type": "string",
                "enum": [
                  "mandatory",
                  "requested",
                  "both"
                ]
              }
            },
            "required": [
              "familyId",
              "source"
            ],
            "additionalProperties": false
          },
          "maxItems": 2048
        },
        "thresholds": {
          "$ref": "#/definitions/PolicyThresholds"
        },
        "agentActions": {
          "type": "string",
          "enum": [
            "confirm",
            "allow"
          ]
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actions": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/SentinelAction"
                }
              },
              "principals": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Principal"
                }
              },
              "confirm": {
                "type": "string",
                "enum": [
                  "always",
                  "agent",
                  "never",
                  "default"
                ]
              },
              "scoped": {
                "type": "boolean"
              }
            },
            "required": [
              "actions",
              "principals",
              "confirm",
              "scoped"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "ollama",
                  "openai-compatible",
                  "claude-cli",
                  "copilot-cli"
                ]
              },
              "disclosure": {
                "type": "string",
                "enum": [
                  "local-only",
                  "hosted"
                ]
              },
              "credential": {
                "type": "string",
                "enum": [
                  "keychain",
                  "none"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "disclosure",
              "credential"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        },
        "refused": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RefusedRequest"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "schema",
        "settingsTrust",
        "settingsDigest",
        "repoConfigDigest",
        "rules",
        "thresholds",
        "agentActions",
        "grants",
        "providers",
        "refused"
      ],
      "additionalProperties": false,
      "description": "sentinel-policy/draft-1 — the redacted effective policy. The only policy view served: no endpoint, keychain reference or raw settings byte appears in it."
    },
    "SettingsTrust": {
      "type": "string",
      "enum": [
        "adopted",
        "not-adopted",
        "changed",
        "missing",
        "invalid"
      ],
      "description": "How far the settings file is trusted. Anything but `adopted` falls back to the built-in defaults."
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "RuleFamilyId": {
      "type": "string",
      "description": "A stable rule family: `sentinel.<area>.<name>` for original rules, `<vendor>.<area>.<name>` otherwise.",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){2,7}$",
      "maxLength": 128
    },
    "PolicyThresholds": {
      "type": "object",
      "properties": {
        "failOnSeverity": {
          "$ref": "#/definitions/Severity",
          "description": "Findings at or above this severity fail the policy. Lower is stricter."
        },
        "requireCompleteCoverage": {
          "type": "boolean",
          "description": "Required checks that do not complete fail the policy with exit 2."
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuleCapability"
          },
          "maxItems": 10
        }
      },
      "required": [
        "failOnSeverity",
        "requireCompleteCoverage",
        "requiredCapabilities"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "The severity a rule assigns. Ordered: info < low < medium < high < critical."
    },
    "RuleCapability": {
      "type": "string",
      "enum": [
        "source-bytes",
        "pattern-match",
        "source-span",
        "call-occurrence",
        "resolved-receiver-type",
        "framework-order",
        "interprocedural-flow",
        "runtime-observation",
        "dependency-manifest",
        "advisory-database"
      ],
      "description": "A property a stage must establish before the rule can be checked. A profile that lacks one leaves the check unsupported; nothing weaker runs under the rule's identity."
    },
    "SentinelAction": {
      "type": "string",
      "enum": [
        "run.start",
        "capture.source",
        "disposition.propose",
        "disposition.approve",
        "rule.promote",
        "tool.acquire",
        "paid.admit",
        "disclosure.send",
        "settings.adopt",
        "evidence.import",
        "evidence.abandon",
        "run.pause",
        "run.cancel",
        "context.pin"
      ],
      "description": "Every action the Sentinel gate decides."
    },
    "Principal": {
      "type": "string",
      "enum": [
        "human",
        "agent"
      ],
      "description": "Who asks. A claimed name grants nothing; the channel the request arrived on is what is recorded."
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "RefusedRequest": {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "enum": [
            "disable-rule",
            "weaken-threshold",
            "suppression",
            "provider"
          ]
        },
        "subject": {
          "type": "string",
          "maxLength": 200
        },
        "reasonCode": {
          "$ref": "#/definitions/CatalogKey"
        }
      },
      "required": [
        "request",
        "subject",
        "reasonCode"
      ],
      "additionalProperties": false,
      "description": "What the repository asked for that the effective policy did not grant, and why."
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-policy.draft-1.schema.json",
  "title": "sentinel-policy/draft-1"
}
