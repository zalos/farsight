{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OwnerDecisionInput",
  "definitions": {
    "OwnerDecisionInput": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-decision-input/draft-1"
        },
        "decision": {
          "$ref": "#/definitions/DispositionDecision"
        },
        "rationale": {
          "$ref": "#/definitions/BoundedText"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Digest"
          },
          "maxItems": 256
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "decision",
        "rationale",
        "evidence",
        "expiresAt",
        "supersedes"
      ],
      "additionalProperties": false,
      "description": "An owner adjudication of one accepted source finding, never proof of a deployed control."
    },
    "DispositionDecision": {
      "type": "string",
      "enum": [
        "accepted-risk",
        "false-positive",
        "mitigated",
        "deferred"
      ],
      "description": "An accepted risk remains a risk; a mitigation is only as strong as the evidence it names."
    },
    "BoundedText": {
      "type": "string",
      "description": "Untrusted text supplied by a producer (a scanner message, a rationale). Always escaped when rendered.",
      "maxLength": 4000
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-decision-input.draft-1.schema.json",
  "title": "sentinel-decision-input/draft-1"
}
