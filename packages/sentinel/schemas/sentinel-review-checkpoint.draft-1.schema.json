{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ReviewCheckpointEnvelope",
  "definitions": {
    "ReviewCheckpointEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-review-checkpoint/draft-1"
        },
        "sessionId": {
          "$ref": "#/definitions/ReviewSessionId"
        },
        "specDigest": {
          "$ref": "#/definitions/Digest",
          "description": "The digest of the session's scope, prompt, limits, budget and tools; another spec cannot resume it."
        },
        "startedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewMessage"
          },
          "minItems": 2,
          "maxItems": 1024
        },
        "served": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServedCitation"
          },
          "maxItems": 1000
        },
        "toolCalls": {
          "$ref": "#/definitions/Count"
        },
        "invalid": {
          "$ref": "#/definitions/Count"
        },
        "inputBytes": {
          "$ref": "#/definitions/Count"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewOperation"
          },
          "maxItems": 256
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "final": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReviewAssessment"
            },
            {
              "type": "null"
            }
          ]
        },
        "stopped": {
          "anyOf": [
            {
              "$ref": "#/definitions/CatalogKey"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema",
        "sessionId",
        "specDigest",
        "startedAt",
        "messages",
        "served",
        "toolCalls",
        "invalid",
        "inputBytes",
        "operations",
        "identity",
        "final",
        "stopped"
      ],
      "additionalProperties": false,
      "description": "sentinel-review-checkpoint/draft-1 — what a session needs to resume after its last settled operation."
    },
    "ReviewSessionId": {
      "type": "string",
      "description": "A review session id.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "ReviewMessage": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "maxLength": 4194304
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false
    },
    "ServedCitation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/EvidenceId"
        },
        "startLine": {
          "$ref": "#/definitions/LineNumber"
        },
        "endLine": {
          "$ref": "#/definitions/LineNumber"
        },
        "citation": {
          "$ref": "#/definitions/SourceEvidence"
        }
      },
      "required": [
        "id",
        "startLine",
        "endLine",
        "citation"
      ],
      "additionalProperties": false,
      "description": "A slice served to the model, without its text: a resumed session re-reads and re-verifies the bytes."
    },
    "EvidenceId": {
      "type": "string",
      "description": "A served evidence id: what a reply cites.",
      "pattern": "^ev-[0-9a-f]{16}$"
    },
    "LineNumber": {
      "type": "integer",
      "description": "A 1-based source line.",
      "minimum": 1,
      "maximum": 100000000
    },
    "SourceEvidence": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "$ref": "#/definitions/Id"
        },
        "sourceId": {
          "$ref": "#/definitions/Id"
        },
        "relativePath": {
          "$ref": "#/definitions/RelativePath"
        },
        "content": {
          "$ref": "#/definitions/ArtifactId"
        },
        "span": {
          "$ref": "#/definitions/ByteSpan"
        },
        "quoteDigest": {
          "$ref": "#/definitions/Digest"
        },
        "nodeId": {
          "$ref": "#/definitions/NodeId"
        },
        "occurrenceId": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "snapshotId",
        "sourceId",
        "relativePath",
        "content",
        "span"
      ],
      "additionalProperties": false,
      "description": "A citation into captured snapshot bytes. Source ID is part of identity: equal paths in two repositories differ."
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "RelativePath": {
      "type": "string",
      "description": "A source-relative POSIX path: no leading or trailing slash, no `.`/`..` segment, no empty segment, no backslash or NUL. A newline or other line break inside a name is a legal POSIX name and is kept as captured; the checks use `[\\s\\S]`, never `.`, so a line break cannot hide a `..` segment from them.",
      "pattern": "^(?![/])(?![\\s\\S]*[/]$)(?!([\\s\\S]*[/])?\\.{1,2}([/]|$))(?![\\s\\S]*[/][/])[^\\\\\\u0000]+$",
      "maxLength": 4096
    },
    "ArtifactId": {
      "$ref": "#/definitions/Digest",
      "description": "An immutable object-store identity: the digest of canonical uncompressed bytes."
    },
    "ByteSpan": {
      "type": "object",
      "properties": {
        "startByte": {
          "$ref": "#/definitions/Count"
        },
        "endByte": {
          "$ref": "#/definitions/Count"
        }
      },
      "required": [
        "startByte",
        "endByte"
      ],
      "additionalProperties": false,
      "description": "Zero-based, half-open UTF-8 byte offsets."
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "NodeId": {
      "type": "string",
      "description": "A canonical application-graph identity (`repo::path/to/File.tsx::Component`), a screen or a journey ID from pinned context. Unlike a ledger `Id` it may contain `/` and `::`; it is bounded and free of control characters.",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
    },
    "ReviewOperation": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/definitions/Id"
        },
        "state": {
          "type": "string",
          "enum": [
            "settled",
            "unsettled"
          ],
          "description": "`settled`: the call answered and was recorded; `unsettled`: it failed and may have been charged."
        },
        "inputBytes": {
          "$ref": "#/definitions/Count"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "$ref": "#/definitions/Count"
            },
            "outputTokens": {
              "$ref": "#/definitions/Count"
            }
          },
          "required": [
            "inputTokens",
            "outputTokens"
          ],
          "additionalProperties": false
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "const": "tool"
            },
            {
              "type": "string",
              "const": "final"
            },
            {
              "type": "string",
              "const": "failed"
            },
            {
              "$ref": "#/definitions/CatalogKey"
            }
          ],
          "description": "What the reply was taken as: a tool request, a final assessment, a rejection code, or a failed call."
        }
      },
      "required": [
        "operationId",
        "state",
        "inputBytes",
        "outcome"
      ],
      "additionalProperties": false
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    },
    "ModelIdentity": {
      "type": "object",
      "properties": {
        "requestedModel": {
          "type": "string",
          "maxLength": 256
        },
        "returnedModel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "immutableRevision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "source": {
          "$ref": "#/definitions/IdentitySource"
        }
      },
      "required": [
        "requestedModel",
        "returnedModel",
        "immutableRevision",
        "source"
      ],
      "additionalProperties": false,
      "description": "A model's identity at the strength it is actually known, never inferred from response text."
    },
    "IdentitySource": {
      "type": "string",
      "enum": [
        "provider-response",
        "local-weight-digest",
        "host-reported",
        "self-reported",
        "unknown"
      ],
      "description": "How a worker's identity is known. Host-reported identity is not provider attestation."
    },
    "ReviewAssessment": {
      "type": "object",
      "properties": {
        "verdict": {
          "$ref": "#/definitions/ReviewVerdict"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewClaim"
          },
          "maxItems": 16
        },
        "inspected": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RelativePath"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "verdict",
        "claims",
        "inspected"
      ],
      "additionalProperties": false
    },
    "ReviewVerdict": {
      "type": "string",
      "enum": [
        "finding",
        "no-finding",
        "inconclusive"
      ]
    },
    "ReviewClaim": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceId"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "cwe": {
          "$ref": "#/definitions/CweId"
        }
      },
      "required": [
        "statement",
        "citations"
      ],
      "additionalProperties": false
    },
    "CweId": {
      "type": "string",
      "pattern": "^CWE-[1-9][0-9]{0,4}$"
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-review-checkpoint.draft-1.schema.json",
  "title": "sentinel-review-checkpoint/draft-1"
}
