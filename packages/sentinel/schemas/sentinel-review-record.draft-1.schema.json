{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ReviewRecordEnvelope",
  "definitions": {
    "ReviewRecordEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-review-record/draft-1"
        },
        "sessionId": {
          "$ref": "#/definitions/ReviewSessionId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "guided",
            "general"
          ]
        },
        "runId": {
          "$ref": "#/definitions/Id"
        },
        "attemptId": {
          "$ref": "#/definitions/Id"
        },
        "snapshotId": {
          "$ref": "#/definitions/Id"
        },
        "sourceId": {
          "$ref": "#/definitions/Id"
        },
        "specDigest": {
          "$ref": "#/definitions/Digest"
        },
        "promptDigest": {
          "$ref": "#/definitions/Digest"
        },
        "instructions": {
          "$ref": "#/definitions/ReviewInstructionBinding"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "callerKind": {
          "type": "string",
          "enum": [
            "mock",
            "provider"
          ],
          "description": "`mock` replies can never qualify anything."
        },
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "unfinished"
          ]
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReviewVerdict"
            },
            {
              "type": "null"
            }
          ]
        },
        "inspected": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewInspection"
          },
          "maxItems": 1000
        },
        "notInspected": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RelativePath"
          },
          "maxItems": 1000
        },
        "frontiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScopedReason"
          },
          "maxItems": 2100
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewOperation"
          },
          "maxItems": 256
        },
        "totals": {
          "type": "object",
          "properties": {
            "steps": {
              "$ref": "#/definitions/Count"
            },
            "toolCalls": {
              "$ref": "#/definitions/Count"
            },
            "inputBytes": {
              "$ref": "#/definitions/Count"
            },
            "inputTokens": {
              "$ref": "#/definitions/Count"
            },
            "outputTokens": {
              "$ref": "#/definitions/Count"
            },
            "usage": {
              "type": "string",
              "enum": [
                "confirmed",
                "unknown"
              ]
            },
            "cost": {
              "$ref": "#/definitions/StageCost",
              "description": "What the provider calls cost, as a stage's provenance states it: the rates price of the confirmed usage, or unobserved with its reason (a subscription CLI, an unsettled call, a provider with no rates); never a zero amount. Absent for a mock caller and on records written before it was recorded."
            }
          },
          "required": [
            "steps",
            "toolCalls",
            "inputBytes",
            "inputTokens",
            "outputTokens",
            "usage"
          ],
          "additionalProperties": false
        },
        "refusals": {
          "$ref": "#/definitions/Count"
        },
        "rejectedReplies": {
          "$ref": "#/definitions/Count"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "maxItems": 16
        },
        "establishes": {
          "type": "string",
          "const": "model-review-inspection"
        },
        "deterministicCoverage": {
          "type": "boolean",
          "const": false
        },
        "digest": {
          "$ref": "#/definitions/Digest"
        }
      },
      "required": [
        "schema",
        "sessionId",
        "kind",
        "runId",
        "attemptId",
        "snapshotId",
        "sourceId",
        "specDigest",
        "promptDigest",
        "model",
        "callerKind",
        "outcome",
        "verdict",
        "inspected",
        "notInspected",
        "frontiers",
        "operations",
        "totals",
        "refusals",
        "rejectedReplies",
        "observations",
        "establishes",
        "deterministicCoverage",
        "digest"
      ],
      "additionalProperties": false,
      "description": "sentinel-review-record/draft-1 — what one review session inspected and concluded. The inspection ledger is what was served, never what the model said; `deterministicCoverage` is always false."
    },
    "ReviewSessionId": {
      "type": "string",
      "description": "A review session id.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ReviewInstructionBinding": {
      "type": "object",
      "properties": {
        "manifest": {
          "$ref": "#/definitions/ArtifactId"
        },
        "digest": {
          "$ref": "#/definitions/Digest"
        },
        "assembled": {
          "$ref": "#/definitions/ArtifactId"
        },
        "sourcePacket": {
          "$ref": "#/definitions/ArtifactId"
        },
        "segmentId": {
          "$ref": "#/definitions/Id"
        },
        "selection": {
          "$ref": "#/definitions/ReviewProviderSelection"
        }
      },
      "required": [
        "manifest",
        "digest",
        "assembled",
        "sourcePacket",
        "segmentId"
      ],
      "additionalProperties": false
    },
    "ArtifactId": {
      "$ref": "#/definitions/Digest",
      "description": "An immutable object-store identity: the digest of canonical uncompressed bytes."
    },
    "ReviewProviderSelection": {
      "type": "object",
      "properties": {
        "providerId": {
          "$ref": "#/definitions/Id"
        },
        "modelId": {
          "$ref": "#/definitions/Id"
        },
        "bindingDigest": {
          "$ref": "#/definitions/Digest"
        }
      },
      "required": [
        "providerId",
        "modelId",
        "bindingDigest"
      ],
      "additionalProperties": false,
      "description": "One exact Sentinel request sent to the caller. Its identity is the request bytes, not a claim about vendor internals."
    },
    "ModelIdentity": {
      "type": "object",
      "properties": {
        "requestedModel": {
          "type": "string",
          "maxLength": 256
        },
        "returnedModel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "immutableRevision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "source": {
          "$ref": "#/definitions/IdentitySource"
        }
      },
      "required": [
        "requestedModel",
        "returnedModel",
        "immutableRevision",
        "source"
      ],
      "additionalProperties": false,
      "description": "A model's identity at the strength it is actually known, never inferred from response text."
    },
    "IdentitySource": {
      "type": "string",
      "enum": [
        "provider-response",
        "local-weight-digest",
        "host-reported",
        "self-reported",
        "unknown"
      ],
      "description": "How a worker's identity is known. Host-reported identity is not provider attestation."
    },
    "ReviewVerdict": {
      "type": "string",
      "enum": [
        "finding",
        "no-finding",
        "inconclusive"
      ]
    },
    "ReviewInspection": {
      "type": "object",
      "properties": {
        "relativePath": {
          "$ref": "#/definitions/RelativePath"
        },
        "content": {
          "$ref": "#/definitions/ArtifactId"
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/LineNumber"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Served line ranges, sorted.",
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "relativePath",
        "content",
        "ranges"
      ],
      "additionalProperties": false
    },
    "RelativePath": {
      "type": "string",
      "description": "A source-relative POSIX path: no leading or trailing slash, no `.`/`..` segment, no empty segment, no backslash or NUL. A newline or other line break inside a name is a legal POSIX name and is kept as captured; the checks use `[\\s\\S]`, never `.`, so a line break cannot hide a `..` segment from them.",
      "pattern": "^(?![/])(?![\\s\\S]*[/]$)(?!([\\s\\S]*[/])?\\.{1,2}([/]|$))(?![\\s\\S]*[/][/])[^\\\\\\u0000]+$",
      "maxLength": 4096
    },
    "LineNumber": {
      "type": "integer",
      "description": "A 1-based source line.",
      "minimum": 1,
      "maximum": 100000000
    },
    "ScopedReason": {
      "type": "object",
      "properties": {
        "scopeId": {
          "$ref": "#/definitions/ScopeId"
        },
        "reasonCode": {
          "$ref": "#/definitions/CatalogKey"
        }
      },
      "required": [
        "scopeId",
        "reasonCode"
      ],
      "additionalProperties": false,
      "description": "A coded reason attached to a scope (a skipped file, an unresolved frontier)."
    },
    "ScopeId": {
      "type": "string",
      "description": "A scope reference such as `<sourceId>:<relativePath>` or a surface ID. Untrusted protocol data: bounded, free of control characters, never resolved as a filesystem path.",
      "pattern": "^[A-Za-z0-9][^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$",
      "maxLength": 4300
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    },
    "ReviewOperation": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/definitions/ArtifactId",
          "description": "Exact retained request for instruction-bound sessions only."
        },
        "identity": {
          "$ref": "#/definitions/ModelIdentity",
          "description": "Reported identity of this reply, never inferred from instruction text."
        },
        "operationId": {
          "$ref": "#/definitions/Id"
        },
        "state": {
          "type": "string",
          "enum": [
            "settled",
            "unsettled"
          ],
          "description": "`settled`: the call answered and was recorded; `unsettled`: it failed and may have been charged."
        },
        "inputBytes": {
          "$ref": "#/definitions/Count"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "$ref": "#/definitions/Count"
            },
            "outputTokens": {
              "$ref": "#/definitions/Count"
            }
          },
          "required": [
            "inputTokens",
            "outputTokens"
          ],
          "additionalProperties": false
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string",
              "const": "tool"
            },
            {
              "type": "string",
              "const": "final"
            },
            {
              "type": "string",
              "const": "failed"
            },
            {
              "$ref": "#/definitions/CatalogKey"
            }
          ],
          "description": "What the reply was taken as: a tool request, a final assessment, a rejection code, or a failed call."
        }
      },
      "required": [
        "operationId",
        "state",
        "inputBytes",
        "outcome"
      ],
      "additionalProperties": false
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "StageCost": {
      "type": "object",
      "properties": {
        "basis": {
          "enum": [
            "rates",
            "unobserved"
          ]
        }
      },
      "required": [
        "basis"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "type": "string",
                "const": "rates"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "basis": {
                "type": "string",
                "const": "rates"
              },
              "amount": {
                "$ref": "#/definitions/DecimalAmount"
              },
              "currency": {
                "$ref": "#/definitions/CurrencyCode"
              }
            },
            "required": [
              "basis",
              "amount",
              "currency"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "type": "string",
                "const": "unobserved"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "basis": {
                "type": "string",
                "const": "unobserved"
              },
              "reason": {
                "$ref": "#/definitions/CostUnobservedReason"
              }
            },
            "required": [
              "basis",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      ],
      "description": "What a model stage cost: always one of two answers, never nothing. `rates`: the provider has owner-entered rates and the usage was confirmed (list price, not a bill). `unobserved`: the cost is not known, with its reason, and is never printed as a zero amount. Only a model stage has a cost; Sentinel's own stages, scanners and scripts have none."
    },
    "DecimalAmount": {
      "type": "string",
      "description": "A non-negative decimal amount written as a string, so money is never a binary float.",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,9})?$"
    },
    "CurrencyCode": {
      "type": "string",
      "description": "An ISO 4217 currency code.",
      "pattern": "^[A-Z]{3}$"
    },
    "CostUnobservedReason": {
      "type": "string",
      "enum": [
        "subscription",
        "usage-unknown",
        "no-rates"
      ],
      "description": "Why a model stage's cost is not known: a subscription CLI reports no price, the usage itself was not confirmed, or the provider has no owner-entered rates."
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-review-record.draft-1.schema.json",
  "title": "sentinel-review-record/draft-1"
}
