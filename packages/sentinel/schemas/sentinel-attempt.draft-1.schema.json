{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AttemptEnvelope",
  "definitions": {
    "AttemptEnvelope": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "interrupted",
            "canceled",
            "canceled-after-spend"
          ]
        }
      },
      "required": [
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "type": "string",
                "const": "running"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/RunningAttempt"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed",
                  "interrupted",
                  "canceled",
                  "canceled-after-spend"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/definitions/EndedAttempt"
          }
        }
      ],
      "description": "sentinel-attempt/draft-1 — one append-only execution of a work revision."
    },
    "RunningAttempt": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-attempt/draft-1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "work": {
          "$ref": "#/definitions/WorkRef"
        },
        "ordinal": {
          "$ref": "#/definitions/Ordinal"
        },
        "coordinatorEpoch": {
          "$ref": "#/definitions/Id"
        },
        "operationId": {
          "$ref": "#/definitions/Id"
        },
        "worker": {
          "$ref": "#/definitions/AttemptWorker"
        },
        "startedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "usage": {
          "$ref": "#/definitions/AttemptUsage"
        },
        "invocation": {
          "$ref": "#/definitions/ArtifactId",
          "description": "The exact invocation record: executable digest, argv, redacted environment identity. Never a credential."
        },
        "state": {
          "type": "string",
          "const": "running"
        }
      },
      "required": [
        "coordinatorEpoch",
        "id",
        "operationId",
        "ordinal",
        "schema",
        "startedAt",
        "state",
        "usage",
        "work",
        "worker"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "WorkRef": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "revision": {
          "$ref": "#/definitions/Ordinal"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false,
      "description": "A logical work unit at one immutable revision; every reference to work names both."
    },
    "Ordinal": {
      "type": "integer",
      "description": "A positive integer ordinal or revision.",
      "minimum": 1,
      "maximum": 2147483647
    },
    "AttemptWorker": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "owned-child",
            "owned-container",
            "external-claim"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "owned-child"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "owned-child"
              },
              "pid": {
                "type": "integer",
                "minimum": 1
              },
              "processStartedAt": {
                "$ref": "#/definitions/Timestamp",
                "description": "Recorded so recovery never kills by command-pattern matching."
              }
            },
            "required": [
              "kind",
              "pid",
              "processStartedAt"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "owned-container"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "owned-container"
              },
              "containerId": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "ownershipLabels": {
                "type": "object",
                "properties": {
                  "store": {
                    "$ref": "#/definitions/Id"
                  },
                  "attempt": {
                    "$ref": "#/definitions/Id"
                  },
                  "epoch": {
                    "$ref": "#/definitions/Id"
                  }
                },
                "required": [
                  "store",
                  "attempt",
                  "epoch"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "containerId",
              "ownershipLabels"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "external-claim"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "external-claim"
              },
              "fencingGeneration": {
                "$ref": "#/definitions/Count"
              },
              "identitySource": {
                "$ref": "#/definitions/IdentitySource"
              }
            },
            "required": [
              "kind",
              "fencingGeneration",
              "identitySource"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second). The pattern bounds each field; the `date-time` format check refuses a day the month does not have.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "IdentitySource": {
      "type": "string",
      "enum": [
        "provider-response",
        "local-weight-digest",
        "host-reported",
        "self-reported",
        "unknown"
      ],
      "description": "How a worker's identity is known. Host-reported identity is not provider attestation."
    },
    "AttemptUsage": {
      "type": "object",
      "properties": {
        "certainty": {
          "$ref": "#/definitions/UsageCertainty"
        },
        "inputTokens": {
          "$ref": "#/definitions/Count"
        },
        "outputTokens": {
          "$ref": "#/definitions/Count"
        },
        "monetaryCost": {
          "$ref": "#/definitions/DecimalAmount"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "certainty"
      ],
      "additionalProperties": false
    },
    "UsageCertainty": {
      "type": "string",
      "enum": [
        "confirmed",
        "unknown",
        "not-applicable"
      ],
      "description": "Confirmed spend and unknown usage are distinct facts; a timeout never proves a provider stopped billing."
    },
    "DecimalAmount": {
      "type": "string",
      "description": "A non-negative decimal amount written as a string, so money is never a binary float.",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,9})?$"
    },
    "ArtifactId": {
      "$ref": "#/definitions/Digest",
      "description": "An immutable object-store identity: the digest of canonical uncompressed bytes."
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EndedAttempt": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-attempt/draft-1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "work": {
          "$ref": "#/definitions/WorkRef"
        },
        "ordinal": {
          "$ref": "#/definitions/Ordinal"
        },
        "coordinatorEpoch": {
          "$ref": "#/definitions/Id"
        },
        "operationId": {
          "$ref": "#/definitions/Id"
        },
        "worker": {
          "$ref": "#/definitions/AttemptWorker"
        },
        "startedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "usage": {
          "$ref": "#/definitions/AttemptUsage"
        },
        "invocation": {
          "$ref": "#/definitions/ArtifactId",
          "description": "The exact invocation record: executable digest, argv, redacted environment identity. Never a credential."
        },
        "state": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "interrupted",
            "canceled",
            "canceled-after-spend"
          ]
        },
        "endedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactId"
          },
          "maxItems": 1024
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/definitions/CatalogKey"
            },
            "retryable": {
              "type": "boolean"
            },
            "diagnostics": {
              "$ref": "#/definitions/ArtifactId"
            }
          },
          "required": [
            "code",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "coordinatorEpoch",
        "endedAt",
        "id",
        "operationId",
        "ordinal",
        "outputs",
        "schema",
        "startedAt",
        "state",
        "usage",
        "work",
        "worker"
      ],
      "additionalProperties": false
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-attempt.draft-1.schema.json",
  "title": "sentinel-attempt/draft-1"
}
