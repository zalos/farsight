{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RunInspection",
  "definitions": {
    "RunInspection": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-run-inspection/draft-1"
        },
        "viewId": {
          "$ref": "#/definitions/Id"
        },
        "storeId": {
          "$ref": "#/definitions/Id"
        },
        "epoch": {
          "$ref": "#/definitions/Id"
        },
        "runKey": {
          "$ref": "#/definitions/ViewHandle"
        },
        "planKey": {
          "$ref": "#/definitions/ViewHandle"
        },
        "snapshotKey": {
          "anyOf": [
            {
              "$ref": "#/definitions/ViewHandle"
            },
            {
              "type": "null"
            }
          ]
        },
        "planRevision": {
          "$ref": "#/definitions/Ordinal"
        },
        "sequence": {
          "$ref": "#/definitions/Count"
        },
        "historical": {
          "type": "boolean"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/definitions/RunState"
            },
            {
              "type": "string",
              "const": "awaiting-first-execution"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/definitions/RunOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "counts": {
          "type": "object",
          "properties": {
            "works": {
              "$ref": "#/definitions/ReportCount"
            },
            "attempts": {
              "$ref": "#/definitions/ReportCount"
            },
            "inputs": {
              "$ref": "#/definitions/ReportCount"
            },
            "outputs": {
              "$ref": "#/definitions/ReportCount"
            }
          },
          "required": [
            "works",
            "attempts",
            "inputs",
            "outputs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "viewId",
        "storeId",
        "epoch",
        "runKey",
        "planKey",
        "snapshotKey",
        "planRevision",
        "sequence",
        "historical",
        "status",
        "outcome",
        "createdAt",
        "expiresAt",
        "counts"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "ViewHandle": {
      "type": "string",
      "pattern": "^h[0-9a-f]{32}$"
    },
    "Ordinal": {
      "type": "integer",
      "description": "A positive integer ordinal or revision.",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "RunState": {
      "anyOf": [
        {
          "$ref": "#/definitions/ActiveRunState"
        },
        {
          "type": "string",
          "const": "completed"
        }
      ]
    },
    "ActiveRunState": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "pausing",
        "paused",
        "canceling",
        "canceled"
      ]
    },
    "RunOutcome": {
      "type": "string",
      "enum": [
        "complete-coverage",
        "partial-coverage",
        "execution-failure"
      ],
      "description": "Completion's own outcome. Findings are independent of it: a complete run can hold critical findings."
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "ReportCount": {
      "type": "object",
      "properties": {
        "n": {
          "$ref": "#/definitions/Count"
        },
        "of": {
          "$ref": "#/definitions/Count"
        },
        "unit": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "bizUnit": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "scope": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "breakdown": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportCountPart"
          },
          "maxItems": 64
        },
        "recheck": {
          "type": "object",
          "properties": {
            "cli": {
              "type": "string",
              "maxLength": 1024
            },
            "mcp": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "required": [
            "cli"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "n",
        "unit",
        "scope",
        "source"
      ],
      "additionalProperties": false,
      "description": "A scoped number with exactly core's `Counted` shape: what it counts (`unit`, and `bizUnit` when the business register prints it), over which scope, from which fold, its partition and the command that re-checks it. Unit, scope and part keys are shared-catalog keys; the tests run core's own `countedProblems` over them."
    },
    "SharedCatalogKey": {
      "type": "string",
      "description": "A key in the shared two-register catalog (`count.unit.journeys`, `sentinel.count.findings`).",
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
      "maxLength": 128
    },
    "ReportCountPart": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/SharedCatalogKey",
          "description": "A catalog key printed with `{n}`."
        },
        "n": {
          "$ref": "#/definitions/Count"
        },
        "label": {
          "$ref": "#/definitions/BoundedText",
          "description": "A name out of the pinned context, when the part is one thing rather than a kind."
        }
      },
      "required": [
        "key",
        "n"
      ],
      "additionalProperties": false,
      "description": "One part of a count's partition: core's `CountPart`. Parts sum to the count they explain."
    },
    "BoundedText": {
      "type": "string",
      "description": "Untrusted text supplied by a producer (a scanner message, a rationale). Always escaped when rendered.",
      "maxLength": 4000
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-run-inspection.draft-1.schema.json",
  "title": "sentinel-run-inspection/draft-1"
}
