{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RunEnvelope",
  "definitions": {
    "RunEnvelope": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "planned",
            "running",
            "pausing",
            "paused",
            "canceling",
            "canceled",
            "completed"
          ]
        }
      },
      "required": [
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "planned",
                  "running",
                  "pausing",
                  "paused",
                  "canceling",
                  "canceled"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/definitions/ActiveRun"
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "type": "string",
                "const": "completed"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/CompletedRun"
          }
        }
      ],
      "description": "sentinel-run/draft-1 — requested analysis over one snapshot with exact locks, policy and budgets."
    },
    "ActiveRun": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-run/draft-1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "baselineId": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotId": {
          "$ref": "#/definitions/Id"
        },
        "planRevision": {
          "$ref": "#/definitions/Ordinal"
        },
        "coordinatorEpoch": {
          "$ref": "#/definitions/Id"
        },
        "ruleLockDigest": {
          "$ref": "#/definitions/Digest"
        },
        "toolLockDigest": {
          "$ref": "#/definitions/Digest"
        },
        "policyRevisionDigest": {
          "$ref": "#/definitions/Digest"
        },
        "promptPolicyDigest": {
          "$ref": "#/definitions/Digest",
          "description": "Present only when model review is part of the plan."
        },
        "requestedScope": {
          "type": "object",
          "properties": {
            "sourceIds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Id"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "profile": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "sourceIds",
            "profile"
          ],
          "additionalProperties": false
        },
        "budgets": {
          "$ref": "#/definitions/RunBudgets"
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "policy": {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/definitions/PolicyResult"
            },
            "exitCode": {
              "$ref": "#/definitions/PolicyExitCode"
            },
            "reasonCodes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CatalogKey"
              },
              "maxItems": 32
            }
          },
          "required": [
            "result",
            "exitCode",
            "reasonCodes"
          ],
          "additionalProperties": false
        },
        "state": {
          "type": "string",
          "enum": [
            "planned",
            "running",
            "pausing",
            "paused",
            "canceling",
            "canceled"
          ]
        }
      },
      "required": [
        "baselineId",
        "budgets",
        "coordinatorEpoch",
        "createdAt",
        "id",
        "parentId",
        "planRevision",
        "policyRevisionDigest",
        "requestedScope",
        "ruleLockDigest",
        "schema",
        "snapshotId",
        "state",
        "toolLockDigest"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "Ordinal": {
      "type": "integer",
      "description": "A positive integer ordinal or revision.",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "RunBudgets": {
      "type": "object",
      "properties": {
        "maxTokens": {
          "anyOf": [
            {
              "$ref": "#/definitions/Count"
            },
            {
              "type": "null"
            }
          ],
          "description": "null: no model work is admitted under this run."
        },
        "maxCost": {
          "anyOf": [
            {
              "$ref": "#/definitions/DecimalAmount"
            },
            {
              "type": "null"
            }
          ],
          "description": "null: no enforceable monetary budget, so a priced hosted profile is unavailable."
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 currency of `maxCost`.",
          "pattern": "^[A-Z]{3}$"
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      },
      "required": [
        "maxTokens",
        "maxCost",
        "deadlineMs"
      ],
      "additionalProperties": false
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "DecimalAmount": {
      "type": "string",
      "description": "A non-negative decimal amount written as a string, so money is never a binary float.",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,9})?$"
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "PolicyResult": {
      "type": "string",
      "enum": [
        "satisfied",
        "finding-policy-failed",
        "required-coverage-incomplete",
        "configuration-failure",
        "awaiting-confirmation"
      ],
      "description": "The recorded CI policy result. Its exit code is fixed by the result (see `policyExitCode`)."
    },
    "PolicyExitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    },
    "CompletedRun": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-run/draft-1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "baselineId": {
          "anyOf": [
            {
              "$ref": "#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotId": {
          "$ref": "#/definitions/Id"
        },
        "planRevision": {
          "$ref": "#/definitions/Ordinal"
        },
        "coordinatorEpoch": {
          "$ref": "#/definitions/Id"
        },
        "ruleLockDigest": {
          "$ref": "#/definitions/Digest"
        },
        "toolLockDigest": {
          "$ref": "#/definitions/Digest"
        },
        "policyRevisionDigest": {
          "$ref": "#/definitions/Digest"
        },
        "promptPolicyDigest": {
          "$ref": "#/definitions/Digest",
          "description": "Present only when model review is part of the plan."
        },
        "requestedScope": {
          "type": "object",
          "properties": {
            "sourceIds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Id"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "profile": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "sourceIds",
            "profile"
          ],
          "additionalProperties": false
        },
        "budgets": {
          "$ref": "#/definitions/RunBudgets"
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "policy": {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/definitions/PolicyResult"
            },
            "exitCode": {
              "$ref": "#/definitions/PolicyExitCode"
            },
            "reasonCodes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CatalogKey"
              },
              "maxItems": 32
            }
          },
          "required": [
            "result",
            "exitCode",
            "reasonCodes"
          ],
          "additionalProperties": false
        },
        "state": {
          "type": "string",
          "const": "completed"
        },
        "outcome": {
          "$ref": "#/definitions/RunOutcome"
        },
        "completedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "baselineId",
        "budgets",
        "completedAt",
        "coordinatorEpoch",
        "createdAt",
        "id",
        "outcome",
        "parentId",
        "planRevision",
        "policyRevisionDigest",
        "requestedScope",
        "ruleLockDigest",
        "schema",
        "snapshotId",
        "state",
        "toolLockDigest"
      ],
      "additionalProperties": false
    },
    "RunOutcome": {
      "type": "string",
      "enum": [
        "complete-coverage",
        "partial-coverage",
        "execution-failure"
      ],
      "description": "Completion's own outcome. Findings are independent of it: a complete run can hold critical findings."
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-run.draft-1.schema.json",
  "title": "sentinel-run/draft-1"
}
