{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ReportEnvelope",
  "definitions": {
    "ReportEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-report/draft-1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "run": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/Id"
            },
            "snapshotId": {
              "$ref": "#/definitions/Id"
            },
            "planRevision": {
              "$ref": "#/definitions/Ordinal"
            }
          },
          "required": [
            "id",
            "snapshotId",
            "planRevision"
          ],
          "additionalProperties": false
        },
        "ledgerSequence": {
          "$ref": "#/definitions/Count"
        },
        "evaluatedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "catalogVersion": {
          "type": "string",
          "maxLength": 64
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "enum": [
                "private",
                "shareable"
              ]
            },
            "profileDigest": {
              "$ref": "#/definitions/Digest"
            }
          },
          "required": [
            "profile",
            "profileDigest"
          ],
          "additionalProperties": false
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "reportId": {
                  "$ref": "#/definitions/Id"
                }
              },
              "required": [
                "reportId"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "type": "object",
          "properties": {
            "findings": {
              "$ref": "#/definitions/ReportCount"
            },
            "observations": {
              "$ref": "#/definitions/ReportCount"
            },
            "coverageGaps": {
              "$ref": "#/definitions/ReportCount"
            },
            "plannedChecks": {
              "$ref": "#/definitions/ReportCount"
            },
            "seenByNoStage": {
              "$ref": "#/definitions/ReportCount",
              "description": "The exact number of included inventory entries no completed stage covered. Always printed, including zero."
            },
            "unknownScopeBoundaries": {
              "$ref": "#/definitions/ReportCount",
              "description": "Inventory boundaries whose descendants were never enumerated: unknown scope, counted apart, never folded into the exact number above and never read as zero files."
            },
            "historical": {
              "$ref": "#/definitions/ReportCount",
              "description": "Baseline findings the current findings do not continue, by comparison label."
            },
            "controlAnswers": {
              "$ref": "#/definitions/ReportCount",
              "description": "Surface/property answers established, partial or not run; never added to findings."
            }
          },
          "required": [
            "findings",
            "observations",
            "coverageGaps",
            "plannedChecks",
            "seenByNoStage",
            "unknownScopeBoundaries"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportFinding"
          },
          "maxItems": 25000
        },
        "inspections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportControlInspection"
          },
          "maxItems": 10000
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportGap"
          },
          "maxItems": 25000
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportDecision"
          },
          "maxItems": 25000
        },
        "decisionEvaluation": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "reasonCode": {
              "type": "string",
              "enum": [
                "sentinel.decision.section.complete",
                "sentinel.decision.section.partial",
                "sentinel.decision.section.unavailable",
                "sentinel.decision.section.limit"
              ]
            }
          },
          "required": [
            "status",
            "reasonCode"
          ],
          "additionalProperties": false,
          "description": "Availability of optional source-only owner adjudication, never scanner coverage."
        },
        "historical": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportHistoricalFinding"
          },
          "maxItems": 25000
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportDefinition"
          },
          "maxItems": 2048
        },
        "artifactClosure": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactId"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "schema",
        "id",
        "run",
        "ledgerSequence",
        "evaluatedAt",
        "catalogVersion",
        "disclosure",
        "completeness",
        "baseline",
        "counts",
        "findings",
        "gaps",
        "decisions",
        "artifactClosure"
      ],
      "additionalProperties": false,
      "description": "sentinel-report/draft-1 — one deterministic projection at a pinned ledger sequence and evaluation time."
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "Ordinal": {
      "type": "integer",
      "description": "A positive integer ordinal or revision.",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ReportCount": {
      "type": "object",
      "properties": {
        "n": {
          "$ref": "#/definitions/Count"
        },
        "of": {
          "$ref": "#/definitions/Count"
        },
        "unit": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "bizUnit": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "scope": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "breakdown": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportCountPart"
          },
          "maxItems": 64
        },
        "recheck": {
          "type": "object",
          "properties": {
            "cli": {
              "type": "string",
              "maxLength": 1024
            },
            "mcp": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "required": [
            "cli"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "n",
        "unit",
        "scope",
        "source"
      ],
      "additionalProperties": false,
      "description": "A scoped number with exactly core's `Counted` shape: what it counts (`unit`, and `bizUnit` when the business register prints it), over which scope, from which fold, its partition and the command that re-checks it. Unit, scope and part keys are shared-catalog keys; the tests run core's own `countedProblems` over them."
    },
    "SharedCatalogKey": {
      "type": "string",
      "description": "A key in the shared two-register catalog (`count.unit.journeys`, `sentinel.count.findings`).",
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
      "maxLength": 128
    },
    "ReportCountPart": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/SharedCatalogKey",
          "description": "A catalog key printed with `{n}`."
        },
        "n": {
          "$ref": "#/definitions/Count"
        },
        "label": {
          "$ref": "#/definitions/BoundedText",
          "description": "A name out of the pinned context, when the part is one thing rather than a kind."
        }
      },
      "required": [
        "key",
        "n"
      ],
      "additionalProperties": false,
      "description": "One part of a count's partition: core's `CountPart`. Parts sum to the count they explain."
    },
    "BoundedText": {
      "type": "string",
      "description": "Untrusted text supplied by a producer (a scanner message, a rationale). Always escaped when rendered.",
      "maxLength": 4000
    },
    "ReportFinding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "observationIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "ruleFamilyId": {
          "type": "string",
          "maxLength": 128
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "title": {
          "$ref": "#/definitions/RegisterText"
        },
        "explanation": {
          "$ref": "#/definitions/RegisterText"
        },
        "place": {
          "$ref": "#/definitions/FindingPlace"
        },
        "comparison": {
          "$ref": "#/definitions/ComparisonLabel"
        },
        "comparisonReason": {
          "$ref": "#/definitions/CatalogKey",
          "description": "Why the comparison label was given."
        },
        "match": {
          "$ref": "#/definitions/FindingMatch"
        },
        "fingerprint": {
          "$ref": "#/definitions/FindingFingerprint"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportEvidence"
          },
          "maxItems": 64
        }
      },
      "required": [
        "id",
        "observationIds",
        "ruleFamilyId",
        "severity",
        "title",
        "explanation",
        "place",
        "evidence"
      ],
      "additionalProperties": false
    },
    "RegisterText": {
      "type": "object",
      "properties": {
        "business": {
          "$ref": "#/definitions/BoundedText"
        },
        "code": {
          "$ref": "#/definitions/BoundedText"
        }
      },
      "required": [
        "business",
        "code"
      ],
      "additionalProperties": false,
      "description": "The same thing said in both registers; the report carries both so it never looks a label up later."
    },
    "FindingPlace": {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string",
          "enum": [
            "matched",
            "mismatched",
            "unavailable"
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "artifact": {
              "$ref": "#/definitions/ArtifactId"
            },
            "sourceBindingReceipt": {
              "$ref": "#/definitions/ArtifactId"
            },
            "projectionVersion": {
              "$ref": "#/definitions/ShortText"
            }
          },
          "required": [
            "artifact",
            "sourceBindingReceipt",
            "projectionVersion"
          ],
          "additionalProperties": false
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeId"
          },
          "description": "Canonical graph node IDs, the same identities `SourceEvidence.nodeId` carries.",
          "maxItems": 256
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/NodeId"
              },
              "label": {
                "$ref": "#/definitions/PlaceLabel"
              },
              "via": {
                "type": "string",
                "enum": [
                  "direct-use",
                  "potential-impact"
                ]
              },
              "evidenceArtifact": {
                "$ref": "#/definitions/ArtifactId"
              }
            },
            "required": [
              "id",
              "label",
              "via",
              "evidenceArtifact"
            ],
            "additionalProperties": false
          },
          "maxItems": 512
        },
        "journeys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/NodeId"
              },
              "label": {
                "$ref": "#/definitions/PlaceLabel"
              },
              "screenIds": {
                "$ref": "#/definitions/ScreenIds"
              }
            },
            "required": [
              "id",
              "label",
              "screenIds"
            ],
            "additionalProperties": false
          },
          "maxItems": 512
        },
        "personas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/NodeId"
              },
              "label": {
                "$ref": "#/definitions/PlaceLabel"
              },
              "screenIds": {
                "$ref": "#/definitions/ScreenIds"
              },
              "declared": {
                "type": "boolean"
              },
              "evidenceArtifact": {
                "$ref": "#/definitions/ArtifactId"
              }
            },
            "required": [
              "id",
              "label",
              "screenIds",
              "declared",
              "evidenceArtifact"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "counts": {
          "type": "object",
          "properties": {
            "screens": {
              "$ref": "#/definitions/ReportCount"
            },
            "journeys": {
              "$ref": "#/definitions/ReportCount"
            },
            "personas": {
              "$ref": "#/definitions/ReportCount"
            }
          },
          "required": [
            "screens",
            "journeys",
            "personas"
          ],
          "additionalProperties": false
        },
        "limitationKeys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogKey"
          },
          "maxItems": 32
        }
      },
      "required": [
        "binding",
        "nodeIds",
        "screens",
        "journeys",
        "personas",
        "counts",
        "limitationKeys"
      ],
      "additionalProperties": false,
      "description": "Report-side application placement. Reachability is navigation evidence, never proof of exploitation."
    },
    "ArtifactId": {
      "$ref": "#/definitions/Digest",
      "description": "An immutable object-store identity: the digest of canonical uncompressed bytes."
    },
    "ShortText": {
      "type": "string",
      "description": "A short label (a severity as supplied, a framework name).",
      "minLength": 1,
      "maxLength": 200
    },
    "NodeId": {
      "type": "string",
      "description": "A canonical application-graph identity (`repo::path/to/File.tsx::Component`), a screen or a journey ID from pinned context. Unlike a ledger `Id` it may contain `/` and `::`; it is bounded and free of control characters.",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
    },
    "PlaceLabel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "business": {
          "$ref": "#/definitions/BoundedText"
        },
        "code": {
          "$ref": "#/definitions/BoundedText"
        }
      },
      "required": [
        "business",
        "code"
      ],
      "description": "A readable label captured from pinned context, so a recipient never looks one up in today's graph."
    },
    "ScreenIds": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NodeId"
      },
      "maxItems": 512
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    },
    "ComparisonLabel": {
      "type": "string",
      "enum": [
        "new",
        "persistent",
        "changed-evidence",
        "changed-detection",
        "reopened",
        "reopened-disposition-expired",
        "resolved-by-comparable-check",
        "removed-surface",
        "unassessed-in-current-scope",
        "incomparable-conditions"
      ],
      "description": "Why a finding pairs or does not pair with the baseline. Absence alone never resolves an issue."
    },
    "FindingMatch": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exact",
            "probable",
            "ambiguous"
          ]
        },
        "baselineFindingIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Id"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "kind",
        "baselineFindingIds"
      ],
      "additionalProperties": false,
      "description": "How a finding paired with the baseline. Probable and ambiguous pairings never resolve or silently continue an issue."
    },
    "FindingFingerprint": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/definitions/ShortText"
        },
        "exact": {
          "$ref": "#/definitions/Digest"
        },
        "probable": {
          "$ref": "#/definitions/Digest"
        }
      },
      "required": [
        "version",
        "exact",
        "probable"
      ],
      "additionalProperties": false,
      "description": "Sentinel's versioned issue fingerprint: exact (rule family and anchor set) and probable (rule family and symbols)."
    },
    "ReportEvidence": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "embedded",
            "withheld"
          ]
        }
      },
      "required": [
        "state"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "type": "string",
                "const": "embedded"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
              },
              "state": {
                "type": "string",
                "const": "embedded"
              },
              "excerpt": {
                "$ref": "#/definitions/BoundedText"
              },
              "content": {
                "$ref": "#/definitions/ArtifactId"
              },
              "location": {
                "$ref": "#/definitions/EvidenceLocation"
              }
            },
            "required": [
              "id",
              "state",
              "excerpt",
              "content"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "type": "string",
                "const": "withheld"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/Id"
              },
              "state": {
                "type": "string",
                "const": "withheld"
              },
              "reasonCode": {
                "$ref": "#/definitions/CatalogKey"
              },
              "content": {
                "$ref": "#/definitions/ArtifactId"
              },
              "location": {
                "$ref": "#/definitions/EvidenceLocation"
              }
            },
            "required": [
              "id",
              "state",
              "reasonCode",
              "content"
            ],
            "additionalProperties": false
          }
        }
      ],
      "description": "Permitted evidence is embedded; omitted evidence keeps its identity and the reason it was withheld."
    },
    "EvidenceLocation": {
      "type": "object",
      "properties": {
        "relativePath": {
          "$ref": "#/definitions/RelativePath"
        },
        "startByte": {
          "$ref": "#/definitions/Count"
        },
        "endByte": {
          "$ref": "#/definitions/Count"
        },
        "startLine": {
          "$ref": "#/definitions/Ordinal"
        },
        "endLine": {
          "$ref": "#/definitions/Ordinal"
        }
      },
      "required": [
        "relativePath",
        "startByte",
        "endByte",
        "startLine",
        "endLine"
      ],
      "additionalProperties": false,
      "description": "Where evidence sits in the captured source. Absent for evidence whose location is itself withheld (secrets)."
    },
    "RelativePath": {
      "type": "string",
      "description": "A source-relative POSIX path: no leading or trailing slash, no `.`/`..` segment, no empty segment, no backslash or NUL. A newline or other line break inside a name is a legal POSIX name and is kept as captured; the checks use `[\\s\\S]`, never `.`, so a line break cannot hide a `..` segment from them.",
      "pattern": "^(?![/])(?![\\s\\S]*[/]$)(?!([\\s\\S]*[/])?\\.{1,2}([/]|$))(?![\\s\\S]*[/][/])[^\\\\\\u0000]+$",
      "maxLength": 4096
    },
    "ReportControlInspection": {
      "type": "object",
      "properties": {
        "sourceId": {
          "$ref": "#/definitions/Id"
        },
        "artifact": {
          "$ref": "#/definitions/ArtifactId"
        },
        "attemptId": {
          "$ref": "#/definitions/Id"
        },
        "work": {
          "$ref": "#/definitions/WorkRef"
        },
        "analysis": {
          "type": "object",
          "properties": {
            "result": {
              "$ref": "#/definitions/ArtifactId"
            },
            "index": {
              "$ref": "#/definitions/ArtifactId"
            },
            "artifact": {
              "$ref": "#/definitions/ArtifactId"
            },
            "manifest": {
              "$ref": "#/definitions/ArtifactId"
            }
          },
          "required": [
            "result",
            "index",
            "artifact",
            "manifest"
          ],
          "additionalProperties": false
        },
        "assessment": {
          "type": "string",
          "const": "none"
        },
        "recognised": {
          "type": "boolean"
        },
        "extent": {
          "$ref": "#/definitions/Count"
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "framework": {
                "type": "string",
                "enum": [
                  "next",
                  "express",
                  "nest",
                  "spring"
                ]
              },
              "packDigest": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/Digest"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ran": {
                "type": "boolean"
              },
              "reasonCode": {
                "$ref": "#/definitions/CatalogKey"
              },
              "versions": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/ShortText"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxItems": 10000
              },
              "envelopes": {
                "$ref": "#/definitions/Count"
              },
              "supportedScope": {
                "type": "object",
                "properties": {
                  "versions": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/definitions/ShortText"
                    }
                  },
                  "properties": {
                    "type": "array",
                    "items": {
