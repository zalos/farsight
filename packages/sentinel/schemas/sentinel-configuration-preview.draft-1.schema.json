{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ConfigurationPreview",
  "definitions": {
    "ConfigurationPreview": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-configuration-preview/draft-1"
        },
        "id": {
          "$ref": "#/definitions/PreparationPreviewId"
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "mode": {
          "type": "string",
          "enum": [
            "workspace",
            "retry"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "local-artifacts",
              "tool-execution"
            ]
          },
          "minItems": 1,
          "maxItems": 2
        },
        "stages": {
          "type": "array",
          "minItems": 4,
          "items": [
            {
              "type": "object",
              "properties": {
                "stage": {
                  "type": "string",
                  "const": "capture"
                },
                "required": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "stage",
                "required"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "stage": {
                  "type": "string",
                  "const": "parse"
                },
                "required": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "stage",
                "required"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "stage": {
                  "type": "string",
                  "const": "inventory"
                },
                "required": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "stage",
                "required"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "stage": {
                  "type": "string",
                  "const": "check"
                },
                "required": {
                  "type": "boolean",
                  "const": false
                }
              },
              "required": [
                "stage",
                "required"
              ],
              "additionalProperties": false
            }
          ],
          "maxItems": 4
        },
        "counts": {
          "type": "object",
          "properties": {
            "selectedRules": {
              "$ref": "#/definitions/ReportCount"
            },
            "mandatoryRules": {
              "$ref": "#/definitions/ReportCount"
            }
          },
          "required": [
            "selectedRules",
            "mandatoryRules"
          ],
          "additionalProperties": false
        },
        "capabilitiesChecked": {
          "type": "boolean",
          "const": false
        },
        "sourceCaptured": {
          "type": "boolean",
          "const": false
        },
        "confirmation": {
          "$ref": "#/definitions/PreparationConfirmation",
          "description": "Absent from MCP. Private socket CLI data only; never a consumed receipt."
        }
      },
      "required": [
        "schema",
        "id",
        "createdAt",
        "expiresAt",
        "mode",
        "effects",
        "stages",
        "counts",
        "capabilitiesChecked",
        "sourceCaptured"
      ],
      "additionalProperties": false
    },
    "PreparationPreviewId": {
      "type": "string",
      "pattern": "^prepare-preview-[a-f0-9]{32}$"
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "ReportCount": {
      "type": "object",
      "properties": {
        "n": {
          "$ref": "#/definitions/Count"
        },
        "of": {
          "$ref": "#/definitions/Count"
        },
        "unit": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "bizUnit": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "scope": {
          "$ref": "#/definitions/SharedCatalogKey"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "breakdown": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReportCountPart"
          },
          "maxItems": 64
        },
        "recheck": {
          "type": "object",
          "properties": {
            "cli": {
              "type": "string",
              "maxLength": 1024
            },
            "mcp": {
              "type": "string",
              "maxLength": 1024
            }
          },
          "required": [
            "cli"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "n",
        "unit",
        "scope",
        "source"
      ],
      "additionalProperties": false,
      "description": "A scoped number with exactly core's `Counted` shape: what it counts (`unit`, and `bizUnit` when the business register prints it), over which scope, from which fold, its partition and the command that re-checks it. Unit, scope and part keys are shared-catalog keys; the tests run core's own `countedProblems` over them."
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "SharedCatalogKey": {
      "type": "string",
      "description": "A key in the shared two-register catalog (`count.unit.journeys`, `sentinel.count.findings`).",
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[A-Za-z0-9]+)+$",
      "maxLength": 128
    },
    "ReportCountPart": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/definitions/SharedCatalogKey",
          "description": "A catalog key printed with `{n}`."
        },
        "n": {
          "$ref": "#/definitions/Count"
        },
        "label": {
          "$ref": "#/definitions/BoundedText",
          "description": "A name out of the pinned context, when the part is one thing rather than a kind."
        }
      },
      "required": [
        "key",
        "n"
      ],
      "additionalProperties": false,
      "description": "One part of a count's partition: core's `CountPart`. Parts sum to the count they explain."
    },
    "BoundedText": {
      "type": "string",
      "description": "Untrusted text supplied by a producer (a scanner message, a rationale). Always escaped when rendered.",
      "maxLength": 4000
    },
    "PreparationConfirmation": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "capture.source",
                "run.cancel"
              ]
            },
            "input": {
              "$ref": "#/definitions/Digest"
            },
            "effects": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "local-artifacts",
                  "tool-execution"
                ]
              },
              "minItems": 1,
              "maxItems": 2
            },
            "budget": {
              "type": "object",
              "properties": {
                "maxTokens": {
                  "type": "null"
                },
                "maxCost": {
                  "type": "null"
                },
                "currency": {
                  "type": "null"
                }
              },
              "required": [
                "maxTokens",
                "maxCost",
                "currency"
              ],
              "additionalProperties": false
            },
            "scope": {
              "type": "object",
              "properties": {
                "profile": {
                  "type": "string",
                  "const": "static"
                },
                "provider": {
                  "type": "null"
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Digest"
                  },
                  "minItems": 1,
                  "maxItems": 1
                }
              },
              "required": [
                "profile",
                "provider",
                "targets"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "action",
            "input",
            "effects",
            "budget",
            "scope"
          ],
          "additionalProperties": false
        },
        "stateDigest": {
          "$ref": "#/definitions/Digest"
        },
        "policyRevision": {
          "$ref": "#/definitions/Digest"
        }
      },
      "required": [
        "intent",
        "stateDigest",
        "policyRevision"
      ],
      "additionalProperties": false,
      "description": "Read-only data for the actual owner CLI only. A client cannot turn this into a receipt or human authority."
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-configuration-preview.draft-1.schema.json",
  "title": "sentinel-configuration-preview/draft-1"
}
