{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ReceiptEnvelope",
  "definitions": {
    "ReceiptEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-receipt/draft-1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "actor": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "owner-cli"
            },
            "principal": {
              "$ref": "#/definitions/ShortText"
            }
          },
          "required": [
            "channel",
            "principal"
          ],
          "additionalProperties": false
        },
        "action": {
          "$ref": "#/definitions/SentinelAction"
        },
        "intentDigest": {
          "$ref": "#/definitions/Digest"
        },
        "stateDigest": {
          "$ref": "#/definitions/Digest"
        },
        "policyRevision": {
          "$ref": "#/definitions/Digest"
        },
        "issuedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "schema",
        "id",
        "actor",
        "action",
        "intentDigest",
        "stateDigest",
        "policyRevision",
        "issuedAt",
        "expiresAt"
      ],
      "additionalProperties": false,
      "description": "sentinel-receipt/draft-1 — a human owner's confirmation of one exact intent: one use, short-lived, bound to the state and policy it was given against. Only the owner's local CLI flow issues one; no product agent can."
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "ShortText": {
      "type": "string",
      "description": "A short label (a severity as supplied, a framework name).",
      "minLength": 1,
      "maxLength": 200
    },
    "SentinelAction": {
      "type": "string",
      "enum": [
        "run.start",
        "capture.source",
        "disposition.propose",
        "disposition.approve",
        "rule.promote",
        "tool.acquire",
        "paid.admit",
        "disclosure.send",
        "settings.adopt",
        "run.pause",
        "run.cancel"
      ],
      "description": "Every action the Sentinel gate decides."
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-receipt.draft-1.schema.json",
  "title": "sentinel-receipt/draft-1"
}
