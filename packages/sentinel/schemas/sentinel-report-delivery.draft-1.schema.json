{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ReportDelivery",
  "definitions": {
    "ReportDelivery": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-report-delivery/draft-1"
        },
        "deliveryId": {
          "$ref": "#/definitions/Id"
        },
        "storeId": {
          "$ref": "#/definitions/Id"
        },
        "epoch": {
          "$ref": "#/definitions/Id"
        },
        "reportId": {
          "$ref": "#/definitions/Id"
        },
        "current": {
          "type": "object",
          "properties": {
            "runId": {
              "$ref": "#/definitions/Id"
            },
            "planRevision": {
              "$ref": "#/definitions/Ordinal"
            },
            "snapshotId": {
              "$ref": "#/definitions/Id"
            },
            "ledgerSequence": {
              "$ref": "#/definitions/Count"
            }
          },
          "required": [
            "runId",
            "planRevision",
            "snapshotId",
            "ledgerSequence"
          ],
          "additionalProperties": false
        },
        "baseline": {
          "type": "object",
          "properties": {
            "runId": {
              "$ref": "#/definitions/Id"
            },
            "planRevision": {
              "$ref": "#/definitions/Ordinal"
            },
            "snapshotId": {
              "$ref": "#/definitions/Id"
            },
            "ledgerSequence": {
              "$ref": "#/definitions/Count"
            }
          },
          "required": [
            "runId",
            "planRevision",
            "snapshotId",
            "ledgerSequence"
          ],
          "additionalProperties": false
        },
        "generationSequence": {
          "$ref": "#/definitions/Count"
        },
        "evaluatedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "disclosure": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "string",
              "const": "shareable"
            },
            "profileDigest": {
              "$ref": "#/definitions/Digest"
            }
          },
          "required": [
            "profile",
            "profileDigest"
          ],
          "additionalProperties": false
        },
        "catalogVersion": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "properties": {
            "binding": {
              "type": "string",
              "const": "unavailable"
            },
            "reasonCode": {
              "type": "string",
              "const": "sentinel.place.noContext"
            }
          },
          "required": [
            "binding",
            "reasonCode"
          ],
          "additionalProperties": false
        },
        "documentDigest": {
          "$ref": "#/definitions/Digest"
        },
        "format": {
          "type": "string",
          "enum": [
            "json",
            "md",
            "html",
            "sarif"
          ]
        },
        "formatDigest": {
          "$ref": "#/definitions/Digest"
        },
        "formatBytes": {
          "$ref": "#/definitions/Count"
        },
        "createdAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "schema",
        "deliveryId",
        "storeId",
        "epoch",
        "reportId",
        "current",
        "generationSequence",
        "evaluatedAt",
        "disclosure",
        "catalogVersion",
        "context",
        "documentDigest",
        "format",
        "formatDigest",
        "formatBytes",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "Ordinal": {
      "type": "integer",
      "description": "A positive integer ordinal or revision.",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-report-delivery.draft-1.schema.json",
  "title": "sentinel-report-delivery/draft-1"
}
