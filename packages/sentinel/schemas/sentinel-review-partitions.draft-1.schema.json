{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ReviewPartitionsEnvelope",
  "definitions": {
    "ReviewPartitionsEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-review-partitions/draft-1"
        },
        "snapshotId": {
          "$ref": "#/definitions/Id"
        },
        "sourceId": {
          "$ref": "#/definitions/Id"
        },
        "bounds": {
          "type": "object",
          "properties": {
            "maxFiles": {
              "$ref": "#/definitions/PartitionFiles"
            },
            "maxBytes": {
              "$ref": "#/definitions/PartitionBytes"
            }
          },
          "required": [
            "maxFiles",
            "maxBytes"
          ],
          "additionalProperties": false
        },
        "partitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewPartition"
          },
          "maxItems": 20000
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScopedReason"
          },
          "maxItems": 20000
        },
        "digest": {
          "$ref": "#/definitions/Digest",
          "description": "Canonical digest of every other field."
        }
      },
      "required": [
        "schema",
        "snapshotId",
        "sourceId",
        "bounds",
        "partitions",
        "gaps",
        "digest"
      ],
      "additionalProperties": false,
      "description": "sentinel-review-partitions/draft-1 — the general review's scope over one source, decided from the captured inventory and the bounds alone, never from findings. Entries no partition covers are gaps with their reasons."
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "PartitionFiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "PartitionBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "ReviewPartition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id",
          "description": "`part-` and 24 hex characters of the digest of the source and its members' paths and contents."
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewPartitionMember"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "bytes": {
          "$ref": "#/definitions/Count"
        }
      },
      "required": [
        "id",
        "members",
        "bytes"
      ],
      "additionalProperties": false
    },
    "ReviewPartitionMember": {
      "type": "object",
      "properties": {
        "relativePath": {
          "$ref": "#/definitions/RelativePath"
        },
        "content": {
          "$ref": "#/definitions/ArtifactId"
        },
        "bytes": {
          "$ref": "#/definitions/Count"
        }
      },
      "required": [
        "relativePath",
        "content",
        "bytes"
      ],
      "additionalProperties": false
    },
    "RelativePath": {
      "type": "string",
      "description": "A source-relative POSIX path: no leading or trailing slash, no `.`/`..` segment, no empty segment, no backslash or NUL. A newline or other line break inside a name is a legal POSIX name and is kept as captured; the checks use `[\\s\\S]`, never `.`, so a line break cannot hide a `..` segment from them.",
      "pattern": "^(?![/])(?![\\s\\S]*[/]$)(?!([\\s\\S]*[/])?\\.{1,2}([/]|$))(?![\\s\\S]*[/][/])[^\\\\\\u0000]+$",
      "maxLength": 4096
    },
    "ArtifactId": {
      "$ref": "#/definitions/Digest",
      "description": "An immutable object-store identity: the digest of canonical uncompressed bytes."
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ScopedReason": {
      "type": "object",
      "properties": {
        "scopeId": {
          "$ref": "#/definitions/ScopeId"
        },
        "reasonCode": {
          "$ref": "#/definitions/CatalogKey"
        }
      },
      "required": [
        "scopeId",
        "reasonCode"
      ],
      "additionalProperties": false,
      "description": "A coded reason attached to a scope (a skipped file, an unresolved frontier)."
    },
    "ScopeId": {
      "type": "string",
      "description": "A scope reference such as `<sourceId>:<relativePath>` or a surface ID. Untrusted protocol data: bounded, free of control characters, never resolved as a filesystem path.",
      "pattern": "^[A-Za-z0-9][^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$",
      "maxLength": 4300
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-review-partitions.draft-1.schema.json",
  "title": "sentinel-review-partitions/draft-1"
}
