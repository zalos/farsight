{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SettingsEnvelope",
  "definitions": {
    "SettingsEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-settings/draft-1"
        },
        "mandatoryRules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuleFamilyId"
          },
          "maxItems": 1024
        },
        "thresholds": {
          "$ref": "#/definitions/PolicyThresholds"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SentinelGrant"
          },
          "maxItems": 64
        },
        "agentActions": {
          "type": "string",
          "enum": [
            "confirm",
            "allow"
          ],
          "description": "`confirm` (the default for untrusted settings): an agent's allowed action still waits for a person."
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProviderSettings"
          },
          "maxItems": 16
        },
        "reviewModels": {
          "$ref": "#/definitions/ReviewModelsSettings",
          "description": "Optional owner-adopted agentic model choices. Absent keeps legacy settings bytes unchanged."
        },
        "hostedApiReviewEnabled": {
          "type": "boolean",
          "description": "Hosted API review is paused when absent or false; explicit adoption is required to enable public dispatch."
        },
        "hostedReviewSecretScan": {
          "type": "string",
          "enum": [
            "required",
            "when-selected"
          ],
          "description": "Hosted disclosure requires complete secret scanning by default; when-selected still requires it whenever the secret rule is selected."
        },
        "nativeClaudeReviewEnabled": {
          "type": "boolean",
          "description": "Native Claude execution is deferred when absent or false; enabling does not establish runtime qualification."
        },
        "hostScripts": {
          "type": "boolean",
          "description": "Host script stages are off when absent or false. On, an owner-promoted script may run on this computer, a weaker isolation class the report names. Read only through the feature registry (`stage.host-scripts`)."
        }
      },
      "required": [
        "schema",
        "mandatoryRules",
        "thresholds",
        "grants",
        "agentActions",
        "providers"
      ],
      "additionalProperties": false,
      "description": "sentinel-settings/draft-1 — `.farsight/sentinel/settings.json`. Its place in a checkout does not make it trusted: only an owner adoption of these exact bytes for this workspace does."
    },
    "RuleFamilyId": {
      "type": "string",
      "description": "A stable rule family: `sentinel.<area>.<name>` for original rules, `<vendor>.<area>.<name>` otherwise.",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){2,7}$",
      "maxLength": 128
    },
    "PolicyThresholds": {
      "type": "object",
      "properties": {
        "failOnSeverity": {
          "$ref": "#/definitions/Severity",
          "description": "Findings at or above this severity fail the policy. Lower is stricter."
        },
        "requireCompleteCoverage": {
          "type": "boolean",
          "description": "Required checks that do not complete fail the policy with exit 2."
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RuleCapability"
          },
          "maxItems": 10
        }
      },
      "required": [
        "failOnSeverity",
        "requireCompleteCoverage",
        "requiredCapabilities"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "The severity a rule assigns. Ordered: info < low < medium < high < critical."
    },
    "RuleCapability": {
      "type": "string",
      "enum": [
        "source-bytes",
        "pattern-match",
        "source-span",
        "call-occurrence",
        "resolved-receiver-type",
        "framework-order",
        "interprocedural-flow",
        "runtime-observation",
        "dependency-manifest",
        "advisory-database"
      ],
      "description": "A property a stage must establish before the rule can be checked. A profile that lacks one leaves the check unsupported; nothing weaker runs under the rule's identity."
    },
    "SentinelGrant": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SentinelAction"
          },
          "minItems": 1,
          "maxItems": 11
        },
        "principals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Principal"
          },
          "maxItems": 2
        },
        "confirm": {
          "type": "string",
          "enum": [
            "always",
            "agent",
            "never"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "profiles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Id"
              },
              "maxItems": 32
            },
            "providers": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Id"
              },
              "maxItems": 32
            },
            "effects": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ActionEffect"
              },
              "maxItems": 5
            }
          },
          "additionalProperties": false,
          "description": "Narrows the grant: profiles and providers it covers, effects it permits. Absent means not narrowed."
        }
      },
      "required": [
        "actions"
      ],
      "additionalProperties": false,
      "description": "A grant over Sentinel actions, read by core's shared matcher (`decideGrants`)."
    },
    "SentinelAction": {
      "type": "string",
      "enum": [
        "run.start",
        "capture.source",
        "disposition.propose",
        "disposition.approve",
        "rule.promote",
        "tool.acquire",
        "paid.admit",
        "disclosure.send",
        "settings.adopt",
        "evidence.import",
        "evidence.abandon",
        "run.pause",
        "run.cancel",
        "context.pin"
      ],
      "description": "Every action the Sentinel gate decides."
    },
    "Principal": {
      "type": "string",
      "enum": [
        "human",
        "agent"
      ],
      "description": "Who asks. A claimed name grants nothing; the channel the request arrived on is what is recorded."
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "ActionEffect": {
      "type": "string",
      "enum": [
        "local-artifacts",
        "source-disclosure",
        "paid-inference",
        "network",
        "tool-execution"
      ],
      "description": "What an admitted action may do beyond reading captured artifacts."
    },
    "ProviderSettings": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ollama",
            "openai-compatible",
            "claude-cli",
            "copilot-cli"
          ]
        },
        "endpoint": {
          "$ref": "#/definitions/EndpointOrigin"
        },
        "credential": {
          "anyOf": [
            {
              "$ref": "#/definitions/KeychainRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "disclosure": {
          "type": "string",
          "enum": [
            "local-only",
            "hosted"
          ],
          "description": "`local-only` keeps source on this machine; `hosted` sends permitted context off it."
        },
        "nativeProfile": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/Id"
            },
            "executableDigest": {
              "$ref": "#/definitions/Digest"
            },
            "helperDigest": {
              "$ref": "#/definitions/Digest"
            },
            "profileDigest": {
              "$ref": "#/definitions/Digest"
            }
          },
          "required": [
            "id",
            "executableDigest",
            "helperDigest",
            "profileDigest"
          ],
          "additionalProperties": false,
          "description": "Explicit owner adoption of the closed native profile; configuration alone is not runtime qualification."
        },
        "copilotProfile": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/Id"
            },
            "executableDigest": {
              "$ref": "#/definitions/Digest"
            },
            "runtimeDigest": {
              "$ref": "#/definitions/Digest"
            },
            "profileDigest": {
              "$ref": "#/definitions/Digest"
            }
          },
          "required": [
            "id",
            "executableDigest",
            "runtimeDigest",
            "profileDigest"
          ],
          "additionalProperties": false,
          "description": "Exact external Copilot code closure, not an authentication or inference attestation."
        },
        "budget": {
          "$ref": "#/definitions/Budget",
          "description": "The most one admitted action may reserve."
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ModelSettings"
          },
          "description": "The models the owner configured for this provider (PR 21). A model is usable only from adopted settings; a caller or repository cannot supply one.",
          "maxItems": 16
        }
      },
      "required": [
        "id",
        "kind",
        "endpoint",
        "credential",
        "disclosure",
        "budget"
      ],
      "additionalProperties": false
    },
    "EndpointOrigin": {
      "type": "string",
      "description": "A provider endpoint origin: scheme, host and optional port, no path, query or credentials.",
      "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?$",
      "maxLength": 300
    },
    "KeychainRef": {
      "type": "string",
      "description": "An OS-keychain reference. Settings hold references only, never secret values or environment names.",
      "pattern": "^keychain:farsight/[a-z0-9][a-z0-9-]{0,62}$"
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Budget": {
      "type": "object",
      "properties": {
        "maxTokens": {
          "anyOf": [
            {
              "$ref": "#/definitions/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxCost": {
          "anyOf": [
            {
              "$ref": "#/definitions/DecimalAmount"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "$ref": "#/definitions/CurrencyCode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "maxTokens",
        "maxCost",
        "currency"
      ],
      "additionalProperties": false,
      "description": "A spending bound. A paid action needs both a token and a cost bound."
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "DecimalAmount": {
      "type": "string",
      "description": "A non-negative decimal amount written as a string, so money is never a binary float.",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,9})?$"
    },
    "CurrencyCode": {
      "type": "string",
      "description": "An ISO 4217 currency code.",
      "pattern": "^[A-Z]{3}$"
    },
    "ModelSettings": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "model": {
          "$ref": "#/definitions/ModelName"
        },
        "limits": {
          "$ref": "#/definitions/ModelLimits"
        },
        "pricing": {
          "$ref": "#/definitions/ModelPricing"
        },
        "terms": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProviderTerms"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required when the provider's disclosure is `hosted`."
        },
        "capability": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelCapability"
            },
            {
              "type": "null"
            }
          ],
          "description": "null until the owner probes and adopts it: an untested model cannot be bound."
        }
      },
      "required": [
        "id",
        "model",
        "limits",
        "pricing",
        "terms",
        "capability"
      ],
      "additionalProperties": false,
      "description": "One configured model of a provider."
    },
    "ModelName": {
      "type": "string",
      "description": "A model name as the provider spells it.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,199}$"
    },
    "ModelLimits": {
      "type": "object",
      "properties": {
        "maxRequestBytes": {
          "$ref": "#/definitions/ModelBytes"
        },
        "maxResponseBytes": {
          "$ref": "#/definitions/ModelBytes"
        },
        "timeoutMs": {
          "$ref": "#/definitions/ModelTimeoutMs"
        },
        "maxOutputTokens": {
          "$ref": "#/definitions/ModelOutputTokens"
        },
        "contextTokens": {
          "$ref": "#/definitions/ModelContextTokens",
          "description": "Worst-case input plus output must fit, so a provider never cuts input silently."
        },
        "maxMessages": {
          "$ref": "#/definitions/ModelMessages"
        },
        "templateTokensPerMessage": {
          "$ref": "#/definitions/ModelTemplateTokens",
          "description": "Tokens a chat template may add per message beyond the bytes sent; part of the worst-case bound."
        }
      },
      "required": [
        "maxRequestBytes",
        "maxResponseBytes",
        "timeoutMs",
        "maxOutputTokens",
        "contextTokens",
        "maxMessages",
        "templateTokensPerMessage"
      ],
      "additionalProperties": false,
      "description": "Hard limits on one model call."
    },
    "ModelBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    },
    "ModelTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "ModelOutputTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 131072
    },
    "ModelContextTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000
    },
    "ModelMessages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "ModelTemplateTokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "ModelPricing": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "rates",
            "no-fee",
            "subscription-quota"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "rates"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "rates"
              },
              "currency": {
                "$ref": "#/definitions/CurrencyCode"
              },
              "inputPerMillion": {
                "$ref": "#/definitions/DecimalAmount"
              },
              "outputPerMillion": {
                "$ref": "#/definitions/DecimalAmount"
              },
              "source": {
                "$ref": "#/definitions/ShortText",
                "description": "Where the owner read the rate schedule."
              },
              "asOf": {
                "$ref": "#/definitions/CalendarDate"
              }
            },
            "required": [
              "kind",
              "currency",
              "inputPerMillion",
              "outputPerMillion",
              "source",
              "asOf"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "no-fee"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "no-fee"
              },
              "basis": {
                "type": "string",
                "const": "local-runtime"
              }
            },
            "required": [
              "kind",
              "basis"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "subscription-quota"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "subscription-quota"
              },
              "basis": {
                "type": "string",
                "const": "owner-subscription"
              }
            },
            "required": [
              "kind",
              "basis"
            ],
            "additionalProperties": false
          }
        }
      ],
      "description": "How a model's spend is priced. There is no unpriced form: an unpriced call cannot be bounded."
    },
    "ShortText": {
      "type": "string",
      "description": "A short label (a severity as supplied, a framework name).",
      "minLength": 1,
      "maxLength": 200
    },
    "CalendarDate": {
      "type": "string",
      "description": "A calendar date, `YYYY-MM-DD`.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "ProviderTerms": {
      "type": "object",
      "properties": {
        "retention": {
          "$ref": "#/definitions/ShortText"
        },
        "training": {
          "type": "string",
          "enum": [
            "not-used",
            "used",
            "unknown"
          ]
        },
        "source": {
          "$ref": "#/definitions/ShortText"
        },
        "recordedAt": {
          "$ref": "#/definitions/CalendarDate"
        }
      },
      "required": [
        "retention",
        "training",
        "source",
        "recordedAt"
      ],
      "additionalProperties": false,
      "description": "A hosted provider's terms as the owner recorded them: endpoint-specific facts, never a protocol promise."
    },
    "ModelCapability": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-model-capability/draft-1"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ollama",
            "openai-compatible",
            "claude-cli",
            "copilot-cli"
          ]
        },
        "origin": {
          "$ref": "#/definitions/EndpointOrigin"
        },
        "model": {
          "$ref": "#/definitions/ModelName"
        },
        "listed": {
          "type": "boolean",
          "const": true
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "An immutable revision the provider listed (Ollama's weight digest), else null."
        },
        "probedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "schema",
        "kind",
        "origin",
        "model",
        "listed",
        "revision",
        "probedAt"
      ],
      "additionalProperties": false,
      "description": "What a probe of one origin found for one model. The owner adopts it with the settings; it is never assumed."
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "ReviewModelsSettings": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewStageModelSelection"
          },
          "maxItems": 2
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReviewSegmentModelSelection"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "stages",
        "segments"
      ],
      "additionalProperties": false,
      "description": "Stage defaults and exact segment overrides. Selection requests do not admit or launch a model."
    },
    "ReviewStageModelSelection": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/definitions/ReviewModelStage"
        },
        "providerId": {
          "$ref": "#/definitions/Id"
        },
        "modelId": {
          "$ref": "#/definitions/Id"
        }
      },
      "required": [
        "stage",
        "providerId",
        "modelId"
      ],
      "additionalProperties": false
    },
    "ReviewModelStage": {
      "type": "string",
      "enum": [
        "guided",
        "general"
      ]
    },
    "ReviewSegmentModelSelection": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/definitions/ReviewModelStage"
        },
        "providerId": {
          "$ref": "#/definitions/Id"
        },
        "modelId": {
          "$ref": "#/definitions/Id"
        },
        "segmentId": {
          "$ref": "#/definitions/Id",
          "description": "Exact prepared review segment identity; never a filesystem path or wildcard."
        }
      },
      "required": [
        "modelId",
        "providerId",
        "segmentId",
        "stage"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-settings.draft-1.schema.json",
  "title": "sentinel-settings/draft-1"
}
