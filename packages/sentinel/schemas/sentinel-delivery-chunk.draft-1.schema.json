{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DeliveryChunk",
  "definitions": {
    "DeliveryChunk": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-delivery-chunk/draft-1"
        },
        "deliveryId": {
          "$ref": "#/definitions/Id"
        },
        "offset": {
          "$ref": "#/definitions/Count"
        },
        "base64": {
          "type": "string",
          "description": "Base64 of raw bytes; a chunk need not end at a UTF-8 character boundary.",
          "maxLength": 87384
        },
        "nextOffset": {
          "anyOf": [
            {
              "$ref": "#/definitions/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "formatDigest": {
          "$ref": "#/definitions/Digest"
        },
        "totalBytes": {
          "$ref": "#/definitions/Count"
        }
      },
      "required": [
        "schema",
        "deliveryId",
        "offset",
        "base64",
        "nextOffset",
        "formatDigest",
        "totalBytes"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-delivery-chunk.draft-1.schema.json",
  "title": "sentinel-delivery-chunk/draft-1"
}
