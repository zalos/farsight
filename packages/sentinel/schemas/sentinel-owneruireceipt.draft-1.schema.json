{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OwnerUiReceiptEnvelope",
  "definitions": {
    "OwnerUiReceiptEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-owneruireceipt/draft-1"
        },
        "id": {
          "$ref": "#/definitions/Id"
        },
        "actor": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "const": "owner-ui"
            },
            "principal": {
              "type": "string",
              "const": "human"
            }
          },
          "required": [
            "channel",
            "principal"
          ],
          "additionalProperties": false
        },
        "action": {
          "type": "string",
          "enum": [
            "capture.source",
            "run.start",
            "run.pause",
            "run.cancel",
            "paid.admit",
            "settings.adopt"
          ],
          "description": "The paired browser confirms capture and the run controls; with U-3, also the model envelopes of a composite start (`paid.admit`, each bound to one envelope) and a pipeline file write (`settings.adopt`, bound to exactly the bytes written; writing only, adoption stays the CLI owner's). It never confirms rules, acquisition, imports or disclosure."
        },
        "intentDigest": {
          "$ref": "#/definitions/Digest"
        },
        "stateDigest": {
          "$ref": "#/definitions/Digest"
        },
        "policyRevision": {
          "$ref": "#/definitions/Digest"
        },
        "issuer": {
          "$ref": "#/definitions/OwnerUiIssuer"
        },
        "issuedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "expiresAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "schema",
        "id",
        "actor",
        "action",
        "intentDigest",
        "stateDigest",
        "policyRevision",
        "issuer",
        "issuedAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "OwnerUiIssuer": {
      "type": "object",
      "properties": {
        "workspaceDigest": {
          "$ref": "#/definitions/Digest"
        },
        "storeId": {
          "$ref": "#/definitions/Id"
        },
        "ownerEpoch": {
          "$ref": "#/definitions/Id"
        },
        "hostInstance": {
          "$ref": "#/definitions/Id"
        },
        "sessionDigest": {
          "$ref": "#/definitions/Digest"
        },
        "contextRevision": {
          "$ref": "#/definitions/Ordinal"
        }
      },
      "required": [
        "workspaceDigest",
        "storeId",
        "ownerEpoch",
        "hostInstance",
        "sessionDigest",
        "contextRevision"
      ],
      "additionalProperties": false
    },
    "Ordinal": {
      "type": "integer",
      "description": "A positive integer ordinal or revision.",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-owneruireceipt.draft-1.schema.json",
  "title": "sentinel-owneruireceipt/draft-1"
}
