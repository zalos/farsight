{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/PathEvidenceEnvelope",
  "definitions": {
    "PathEvidenceEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-paths/draft-1"
        },
        "snapshotId": {
          "$ref": "#/definitions/Id"
        },
        "sourceId": {
          "$ref": "#/definitions/Id"
        },
        "analysisFingerprint": {
          "type": "string",
          "maxLength": 256
        },
        "graphDigest": {
          "$ref": "#/definitions/Digest",
          "description": "Digest of the canonical node and edge set the search read."
        },
        "bounds": {
          "$ref": "#/definitions/PathBounds"
        },
        "boundsDigest": {
          "$ref": "#/definitions/Digest"
        },
        "establishes": {
          "type": "string",
          "const": "call-reachability"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathQueryResult"
          },
          "maxItems": 10000
        },
        "cycles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CallCycle"
          },
          "description": "Call cycles met, each as its member nodes (bounded).",
          "maxItems": 1000
        },
        "limitationKeys": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogKey"
          },
          "maxItems": 64
        },
        "frontiers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ScopedReason"
          },
          "maxItems": 10000
        },
        "producer": {
          "type": "object",
          "properties": {
            "implementation": {
              "$ref": "#/definitions/ShortText"
            },
            "digest": {
              "$ref": "#/definitions/Digest"
            }
          },
          "required": [
            "implementation",
            "digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "snapshotId",
        "sourceId",
        "analysisFingerprint",
        "graphDigest",
        "bounds",
        "boundsDigest",
        "establishes",
        "results",
        "cycles",
        "limitationKeys",
        "frontiers",
        "producer"
      ],
      "additionalProperties": false,
      "description": "sentinel-paths/draft-1 — bounded static call paths over one source's parser analysis, keyed by the analysis fingerprint, a digest of the graph read and the bounds. `establishes` is fixed: a path is call reachability, never data flow, taint or protection."
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "PathBounds": {
      "type": "object",
      "properties": {
        "edgeKinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathEdgeKind"
          },
          "maxItems": 3
        },
        "maxDepth": {
          "$ref": "#/definitions/PathDepth",
          "description": "Edges in the longest path explored."
        },
        "maxFanout": {
          "$ref": "#/definitions/PathFanout",
          "description": "Outgoing edges followed per node; beyond it the node is a frontier."
        },
        "maxVisited": {
          "$ref": "#/definitions/PathVisits",
          "description": "Nodes visited per query."
        }
      },
      "required": [
        "edgeKinds",
        "maxDepth",
        "maxFanout",
        "maxVisited"
      ],
      "additionalProperties": false
    },
    "PathEdgeKind": {
      "type": "string",
      "enum": [
        "calls",
        "http",
        "renders"
      ],
      "description": "The edge kinds a path may follow. Guard, validation and test edges are never traversed: they are not calls."
    },
    "PathDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "PathFanout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "PathVisits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "PathQueryResult": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/definitions/NodeId"
        },
        "to": {
          "$ref": "#/definitions/NodeId"
        },
        "outcome": {
          "$ref": "#/definitions/PathOutcome"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CallPath"
          },
          "description": "The shortest path found, for `reached`.",
          "maxItems": 1
        },
        "frontierReasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogKey"
          },
          "description": "Why a search was bounded: the frontier kinds it met, each once.",
          "maxItems": 16
        },
        "visited": {
          "$ref": "#/definitions/Count",
          "description": "Nodes visited."
        }
      },
      "required": [
        "from",
        "to",
        "outcome",
        "paths",
        "frontierReasons",
        "visited"
      ],
      "additionalProperties": false
    },
    "NodeId": {
      "type": "string",
      "description": "A canonical application-graph identity (`repo::path/to/File.tsx::Component`), a screen or a journey ID from pinned context. Unlike a ledger `Id` it may contain `/` and `::`; it is bounded and free of control characters.",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]+$"
    },
    "PathOutcome": {
      "type": "string",
      "enum": [
        "reached",
        "not-reached-complete",
        "not-reached-bounded"
      ],
      "description": "`reached`: a path exists within the bounds. `not-reached-complete`: the search ended with nothing left unexplored and no unresolved or truncated edge on the way, which is still only a statement about the parser's graph. `not-reached-bounded`: the search met a frontier, so absence is not established."
    },
    "CallPath": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Digest",
          "description": "Digest of the node and edge sequence."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathStep"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "cyclic": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeId"
          },
          "description": "Nodes on the path that belong to a call cycle (a strongly connected component of more than one node, or a self call).",
          "maxItems": 65
        }
      },
      "required": [
        "id",
        "steps",
        "cyclic"
      ],
      "additionalProperties": false
    },
    "PathStep": {
      "type": "object",
      "properties": {
        "edgeId": {
          "type": "string",
          "maxLength": 1024
        },
        "from": {
          "$ref": "#/definitions/NodeId"
        },
        "to": {
          "$ref": "#/definitions/NodeId"
        },
        "kind": {
          "$ref": "#/definitions/PathEdgeKind"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "resolved",
            "heuristic"
          ],
          "description": "The parser's own resolution of this edge; unresolved edges end a search and are never steps."
        },
        "deferred": {
          "type": "boolean",
          "description": "The edge was made in a callback stored for later: the call may not happen on this path's request."
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PathSite"
          },
          "description": "Captured call sites for this edge; empty when the parser gave none with an exact span.",
          "maxItems": 16
        }
      },
      "required": [
        "edgeId",
        "from",
        "to",
        "kind",
        "resolution",
        "deferred",
        "sites"
      ],
      "additionalProperties": false
    },
    "PathSite": {
      "type": "object",
      "properties": {
        "relativePath": {
          "$ref": "#/definitions/RelativePath"
        },
        "content": {
          "$ref": "#/definitions/ArtifactId"
        },
        "span": {
          "$ref": "#/definitions/ByteSpan"
        },
        "occurrenceId": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "relativePath",
        "content",
        "span",
        "occurrenceId"
      ],
      "additionalProperties": false,
      "description": "A call-site citation in captured bytes, from the parser's occurrence index."
    },
    "RelativePath": {
      "type": "string",
      "description": "A source-relative POSIX path: no leading or trailing slash, no `.`/`..` segment, no empty segment, no backslash or NUL. A newline or other line break inside a name is a legal POSIX name and is kept as captured; the checks use `[\\s\\S]`, never `.`, so a line break cannot hide a `..` segment from them.",
      "pattern": "^(?![/])(?![\\s\\S]*[/]$)(?!([\\s\\S]*[/])?\\.{1,2}([/]|$))(?![\\s\\S]*[/][/])[^\\\\\\u0000]+$",
      "maxLength": 4096
    },
    "ArtifactId": {
      "$ref": "#/definitions/Digest",
      "description": "An immutable object-store identity: the digest of canonical uncompressed bytes."
    },
    "ByteSpan": {
      "type": "object",
      "properties": {
        "startByte": {
          "$ref": "#/definitions/Count"
        },
        "endByte": {
          "$ref": "#/definitions/Count"
        }
      },
      "required": [
        "startByte",
        "endByte"
      ],
      "additionalProperties": false,
      "description": "Zero-based, half-open UTF-8 byte offsets."
    },
    "Count": {
      "type": "integer",
      "description": "A non-negative integer.",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    },
    "CallCycle": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NodeId"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      },
      "required": [
        "members"
      ],
      "additionalProperties": false
    },
    "ScopedReason": {
      "type": "object",
      "properties": {
        "scopeId": {
          "$ref": "#/definitions/ScopeId"
        },
        "reasonCode": {
          "$ref": "#/definitions/CatalogKey"
        }
      },
      "required": [
        "scopeId",
        "reasonCode"
      ],
      "additionalProperties": false,
      "description": "A coded reason attached to a scope (a skipped file, an unresolved frontier)."
    },
    "ScopeId": {
      "type": "string",
      "description": "A scope reference such as `<sourceId>:<relativePath>` or a surface ID. Untrusted protocol data: bounded, free of control characters, never resolved as a filesystem path.",
      "pattern": "^[A-Za-z0-9][^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$",
      "maxLength": 4300
    },
    "ShortText": {
      "type": "string",
      "description": "A short label (a severity as supplied, a framework name).",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-paths.draft-1.schema.json",
  "title": "sentinel-paths/draft-1"
}
