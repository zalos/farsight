{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AdmissionEnvelope",
  "definitions": {
    "AdmissionEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-admission/draft-1"
        },
        "action": {
          "$ref": "#/definitions/SentinelAction"
        },
        "intentDigest": {
          "$ref": "#/definitions/Digest"
        },
        "requestedBy": {
          "type": "object",
          "properties": {
            "principal": {
              "$ref": "#/definitions/Principal"
            },
            "channel": {
              "$ref": "#/definitions/DecisionChannel"
            }
          },
          "required": [
            "principal",
            "channel"
          ],
          "additionalProperties": false
        },
        "policyRevision": {
          "$ref": "#/definitions/Digest"
        },
        "verdicts": {
          "type": "object",
          "properties": {
            "policy": {
              "$ref": "#/definitions/AdmissionVerdict"
            },
            "capability": {
              "$ref": "#/definitions/AdmissionVerdict"
            },
            "credential": {
              "$ref": "#/definitions/CredentialVerdict"
            }
          },
          "required": [
            "policy",
            "capability",
            "credential"
          ],
          "additionalProperties": false
        },
        "outcome": {
          "$ref": "#/definitions/AdmissionOutcome"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "decidedAt": {
          "$ref": "#/definitions/Timestamp"
        }
      },
      "required": [
        "schema",
        "action",
        "intentDigest",
        "requestedBy",
        "policyRevision",
        "verdicts",
        "outcome",
        "receipt",
        "decidedAt"
      ],
      "additionalProperties": false,
      "description": "sentinel-admission/draft-1 — the three ANDed verdicts for one intent: policy, capability, credential authority."
    },
    "SentinelAction": {
      "type": "string",
      "enum": [
        "run.start",
        "capture.source",
        "disposition.propose",
        "disposition.approve",
        "rule.promote",
        "tool.acquire",
        "paid.admit",
        "disclosure.send",
        "settings.adopt",
        "evidence.import",
        "run.pause",
        "run.cancel",
        "context.pin"
      ],
      "description": "Every action the Sentinel gate decides."
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Principal": {
      "type": "string",
      "enum": [
        "human",
        "agent"
      ],
      "description": "Who asks. A claimed name grants nothing; the channel the request arrived on is what is recorded."
    },
    "DecisionChannel": {
      "type": "string",
      "enum": [
        "owner-cli",
        "mcp",
        "http-bridge",
        "model",
        "local-service",
        "owner-ui"
      ],
      "description": "Where a decision came from. Only a trusted local owner action approves; MCP, HTTP, model output and any client of the owner's local service (`local-service`, the owner's own CLI included when it talks to the service) propose."
    },
    "AdmissionVerdict": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "asked": {
          "type": "boolean"
        },
        "reasonCode": {
          "$ref": "#/definitions/CatalogKey"
        },
        "detail": {
          "$ref": "#/definitions/BoundedText"
        }
      },
      "required": [
        "allowed",
        "asked",
        "reasonCode",
        "detail"
      ],
      "additionalProperties": false,
      "description": "One verdict as recorded. `asked: false` when an earlier verdict already denied, so nothing was contacted."
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    },
    "BoundedText": {
      "type": "string",
      "description": "Untrusted text supplied by a producer (a scanner message, a rationale). Always escaped when rendered.",
      "maxLength": 4000
    },
    "CredentialVerdict": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "asked": {
          "type": "boolean"
        },
        "reasonCode": {
          "$ref": "#/definitions/CatalogKey"
        },
        "detail": {
          "$ref": "#/definitions/BoundedText"
        },
        "basis": {
          "type": "string",
          "enum": [
            "local-only",
            "keychain-scope",
            "unknown",
            "not-asked"
          ]
        }
      },
      "required": [
        "allowed",
        "asked",
        "basis",
        "detail",
        "reasonCode"
      ],
      "additionalProperties": false,
      "description": "The credential verdict says how authority was established, including when none was needed."
    },
    "AdmissionOutcome": {
      "type": "string",
      "enum": [
        "admitted",
        "denied",
        "awaiting-confirmation"
      ],
      "description": "Whether an action was admitted, denied, or waits for the owner."
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-admission.draft-1.schema.json",
  "title": "sentinel-admission/draft-1"
}
