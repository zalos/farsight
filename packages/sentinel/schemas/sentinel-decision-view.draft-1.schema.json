{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DecisionViewEnvelope",
  "definitions": {
    "DecisionViewEnvelope": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentinel-decision-view/draft-1"
        },
        "evaluator": {
          "type": "string",
          "const": "sentinel-decision-evaluation/2"
        },
        "authority": {
          "type": "string",
          "const": "owner-adjudication-of-accepted-source"
        },
        "disclosure": {
          "type": "string",
          "const": "owner-local"
        },
        "evaluatedAt": {
          "$ref": "#/definitions/Timestamp"
        },
        "journalHead": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "withheld": {
          "type": "boolean"
        },
        "limitationKey": {
          "type": "string",
          "const": "sentinel.decision.sourceOnly"
        },
        "decision": {
          "$ref": "#/definitions/OwnerDecisionProjection"
        }
      },
      "required": [
        "schema",
        "evaluator",
        "authority",
        "disclosure",
        "evaluatedAt",
        "journalHead",
        "withheld",
        "limitationKey",
        "decision"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "description": "A UTC RFC 3339 timestamp with an explicit Z offset and a real calendar date (no leap second), years 0000–9999 proleptic Gregorian, up to nine fractional digits. The pattern bounds each field; the `date-time` format check refuses a day the month does not have. Comparisons keep all nine digits.",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "format": "date-time"
    },
    "Digest": {
      "type": "string",
      "description": "A SHA-256 content address, lower-case hex.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "OwnerDecisionProjection": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/Id"
        },
        "findingId": {
          "$ref": "#/definitions/Id"
        },
        "basisDigest": {
          "anyOf": [
            {
              "$ref": "#/definitions/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "$ref": "#/definitions/DispositionDecision"
        },
        "scope": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "finding-source"
            },
            "findingId": {
              "$ref": "#/definitions/Id"
            }
          },
          "required": [
            "kind",
            "findingId"
          ],
          "additionalProperties": false
        },
        "approval": {
          "type": "string",
          "enum": [
            "proposed",
            "approved"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "accepted-risk",
            "false-positive"
          ]
        },
        "validity": {
          "type": "string",
          "enum": [
            "none",
            "valid",
            "expired",
            "invalidated"
          ]
        },
        "reasonCode": {
          "$ref": "#/definitions/CatalogKey"
        },
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/definitions/BoundedText"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "findingId",
        "basisDigest",
        "decision",
        "scope",
        "approval",
        "state",
        "validity",
        "reasonCode",
        "expiresAt",
        "rationale"
      ],
      "additionalProperties": false
    },
    "Id": {
      "type": "string",
      "description": "A ledger identifier. Opaque, bounded and free of path separators and whitespace.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "maxLength": 128
    },
    "DispositionDecision": {
      "type": "string",
      "enum": [
        "accepted-risk",
        "false-positive",
        "mitigated",
        "deferred"
      ],
      "description": "An accepted risk remains a risk; a mitigation is only as strong as the evidence it names."
    },
    "CatalogKey": {
      "type": "string",
      "description": "A stable code from the Sentinel catalog, never free text (`sentinel.reason.tooLarge`).",
      "pattern": "^sentinel\\.[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
      "maxLength": 128
    },
    "BoundedText": {
      "type": "string",
      "description": "Untrusted text supplied by a producer (a scanner message, a rationale). Always escaped when rendered.",
      "maxLength": 4000
    }
  },
  "$id": "https://github.com/zalos/farsight/packages/sentinel/schemas/sentinel-decision-view.draft-1.schema.json",
  "title": "sentinel-decision-view/draft-1"
}
