{
  "name": "@farsight/sentinel",
  "version": "0.0.0-draft.1",
  "private": true,
  "description": "Optional isolated security analysis with explicitly adopted pinned scanner assets",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "farsight-sentinel": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot/index.d.ts",
      "import": "./dist/snapshot/index.js"
    },
    "./parser": {
      "types": "./dist/snapshot/parser.d.ts",
      "import": "./dist/snapshot/parser.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "import": "./dist/rules/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js"
    },
    "./planner": {
      "types": "./dist/planner/index.d.ts",
      "import": "./dist/planner/index.js"
    },
    "./findings": {
      "types": "./dist/findings/index.d.ts",
      "import": "./dist/findings/index.js"
    },
    "./reports": {
      "types": "./dist/reports/index.d.ts",
      "import": "./dist/reports/index.js"
    },
    "./frameworks/express": {
      "types": "./dist/frameworks/express/index.d.ts",
      "import": "./dist/frameworks/express/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json",
    "./frameworks/spring": {
      "types": "./dist/frameworks/spring/index.d.ts",
      "import": "./dist/frameworks/spring/index.js"
    },
    "./frameworks/nest": {
      "types": "./dist/frameworks/nest/index.d.ts",
      "import": "./dist/frameworks/nest/index.js"
    },
    "./review/providers": {
      "types": "./dist/review/providers/index.d.ts",
      "import": "./dist/review/providers/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "import": "./dist/analysis/index.js"
    },
    "./frameworks/next": {
      "types": "./dist/frameworks/next/index.d.ts",
      "import": "./dist/frameworks/next/index.js"
    },
    "./review": {
      "types": "./dist/review/index.d.ts",
      "import": "./dist/review/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "rules",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "schemas": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check"
  },
  "dependencies": {
    "@farsight/code-parser": "workspace:*",
    "@farsight/core": "workspace:*",
    "@farsight/graph": "workspace:*",
    "@types/node": "26.1.0",
    "ajv": "8.20.0",
    "oxc-parser": "0.138.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.6"
  }
}
