{
  "name": "@farsight/sentinel",
  "version": "0.0.0-draft.1",
  "private": true,
  "description": "Optional Sentinel security-analysis boundary: draft contracts and schemas only, no scanner yet",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "farsight-sentinel": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts",
    "schemas": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check"
  },
  "dependencies": {
    "@farsight/core": "workspace:*",
    "ajv": "8.20.0"
  }
}
