{
  "rules": [
    {
      "id": "sentinel.sql.request-to-query-java",
      "languages": [
        "java"
      ],
      "severity": "WARNING",
      "message": "Sentinel original local taint: a request value reaches a query in the same function. Local evidence only.",
      "mode": "taint",
      "pattern-sources": [
        {
          "pattern": "$REQUEST.value()"
        }
      ],
      "pattern-sinks": [
        {
          "patterns": [
            {
              "pattern": "$DB.query($SQL, ...)"
            },
            {
              "focus-metavariable": "$SQL"
            }
          ]
        }
      ]
    }
  ]
}
