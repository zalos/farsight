{
  "name": "@farsight/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "farsight": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@farsight/core": "*",
    "@farsight/parsers": "*",
    "@farsight/server": "*",
    "@farsight/mcp": "*",
    "@farsight/work": "*",
    "@farsight/work-fixture": "*",
    "@farsight/work-jira": "*",
    "@farsight/work-azdo": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@farsight/graph": "*"
  }
}
