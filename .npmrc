# ESLint's Ajv 6 still resolves its own uri-js dependency. Keep that package out of pnpm's shared hoist directory:
# fast-uri ships a benchmark importing uri-js outside its runtime dependencies, which Sentinel's closure refuses.
# Existing worktrees after pulling: run pnpm install --config.confirm-modules-purge=false once; non-TTY pnpm 9 can otherwise exit 0 without installing.
hoist-pattern[]=*
hoist-pattern[]=!uri-js
# npm-compatible ranges still resolve to local workspace links under pnpm 9.
link-workspace-packages=true
