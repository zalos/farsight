{
  "name": "farsight",
  "private": true,
  "version": "0.3.0",
  "description": "Parse codebases into a semantic graph and explore them through a game-inspired GUI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zalos/farsight.git"
  },
  "scripts": {
    "pack:echo": "pnpm --filter @farsight/echo... build && node scripts/pack-echo.mjs",
    "test:echo:package": "pnpm pack:echo && node scripts/test-echo-package.mjs",
    "pack:cli": "pnpm --filter @farsight/cli... build && node scripts/pack.mjs",
    "test:cli:package": "pnpm pack:cli && node scripts/test-farsight-package.mjs",
    "test:cli:package:absent": "node scripts/test-farsight-package-absent.mjs",
    "pack:sentinel": "pnpm --filter @farsight/sentinel... build && node scripts/pack-sentinel.mjs",
    "test:sentinel:package": "pnpm pack:sentinel && node scripts/test-sentinel-consumers.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && pnpm e2e:typecheck",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test \"scripts/test/*.test.mjs\"",
    "lint:strings": "node scripts/lint-strings.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:perf": "node scripts/e2e-perf.mjs",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "lint:commits": "node scripts/lint-commits.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "pack:parser": "pnpm --filter @farsight/code-parser... build && node scripts/pack-parser.mjs",
    "test:parser:package": "pnpm pack:parser && node scripts/test-parser-package.mjs",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --quiet .",
    "lint:report": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "verify:format": "node scripts/ast-equivalence.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.0",
    "esbuild": "^0.28.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "8.72.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
