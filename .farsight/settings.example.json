{
  "theme": "dark",
  "defaultLens": "hybrid",
  "sources": [
    {
      "id": "farsight",
      "name": "farsight",
      "type": "local",
      "path": ".",
      "exclude": ["examples/**", "prototypes/**"],
      "enabled": true
    },
    {
      "id": "invoice-app",
      "name": "invoice-app",
      "type": "local",
      "path": "examples/invoice-app",
      "enabled": true
    },
    {
      "id": "spring-invoice-api",
      "name": "spring-invoice-api",
      "type": "local",
      "path": "examples/spring-invoice-api",
      "enabled": true
    },
    {
      "id": "jira-example",
      "name": "Jira — example",
      "type": "work",
      "provider": "jira",
      "site": "https://example.atlassian.net",
      "path": "",
      "enabled": false,
      "scope": { "projects": ["KAN"] },
      "mode": "edit",
      "auth": {
        "kind": "api-token",
        "user": "dev@example.com",
        "secret": "keychain:farsight/jira-example"
      },
      "poll": "5m",
      "permissions": {
        "default": "deny",
        "grants": [
          { "actions": ["comment", "label"], "principals": ["human", "agent"] },
          { "actions": ["assign", "transition", "edit", "link"], "principals": ["human"] }
        ],
        "agentWrites": "confirm",
        "attribution": "prefix"
      }
    },
    {
      "id": "ado-example",
      "name": "Azure DevOps — example-org",
      "type": "work",
      "provider": "azure-devops",
      "org": "https://dev.azure.com/example-org",
      "path": "",
      "enabled": false,
      "scope": { "projects": ["ExampleProject"] },
      "mode": "read-only",
      "auth": {
        "kind": "pat",
        "secret": "keychain:farsight/ado-example"
      },
      "poll": "5m"
    }
  ],
  "collections": [
    { "name": "Invoice systems", "sourceIds": ["invoice-app", "spring-invoice-api"] }
  ],
  "defaultSurface": "codemap",
  "flags": { "journeyDrill": true, "map": true }
}
