{
  "schema": "sentinel-settings/draft-1",
  "mandatoryRules": ["sentinel.secrets.committed-credential", "sentinel.sql.dynamic-query"],
  "thresholds": {
    "failOnSeverity": "high",
    "requireCompleteCoverage": true,
    "requiredCapabilities": ["source-bytes", "pattern-match"]
  },
  "grants": [
    { "actions": ["run.start", "capture.source"], "principals": ["human", "agent"] },
    { "actions": ["disposition.propose"], "principals": ["human", "agent"], "confirm": "never" },
    {
      "actions": ["paid.admit", "disclosure.send"],
      "principals": ["human", "agent"],
      "confirm": "always",
      "scope": { "providers": ["local-review", "hosted-review"], "effects": ["paid-inference", "source-disclosure", "network"] }
    },
    { "actions": ["disposition.approve", "rule.promote", "tool.acquire", "settings.adopt"], "principals": ["human"] }
  ],
  "agentActions": "confirm",
  "providers": [
    {
      "id": "local-review",
      "kind": "ollama",
      "endpoint": "http://127.0.0.1:11434",
      "credential": null,
      "disclosure": "local-only",
      "budget": { "maxTokens": 200000, "maxCost": "0", "currency": "USD" }
    },
    {
      "id": "hosted-review",
      "kind": "openai-compatible",
      "endpoint": "https://models.example.com",
      "credential": "keychain:farsight/sentinel-example",
      "disclosure": "hosted",
      "budget": { "maxTokens": 100000, "maxCost": "5.00", "currency": "USD" }
    }
  ]
}
