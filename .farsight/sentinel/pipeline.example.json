{
  "schema": "sentinel-pipeline/draft-1",
  "id": "default",
  "revision": 1,
  "stages": [
    {
      "id": "capture",
      "kind": "builtin",
      "operation": "capture"
    },
    {
      "id": "parse",
      "kind": "builtin",
      "operation": "parse",
      "needs": [
        "capture"
      ],
      "fanOut": "per-source"
    },
    {
      "id": "inventory",
      "kind": "builtin",
      "operation": "inventory",
      "needs": [
        "parse"
      ]
    },
    {
      "id": "secrets",
      "kind": "tool",
      "adapter": "secrets-gitleaks",
      "rules": [
        "sentinel.secrets.current-tree"
      ],
      "needs": [
        "capture",
        "inventory"
      ],
      "required": true
    },
    {
      "id": "patterns",
      "kind": "tool",
      "adapter": "pattern-semgrep",
      "rules": "pack:builtin:pattern",
      "needs": [
        "capture",
        "parse"
      ]
    },
    {
      "id": "review",
      "kind": "agent",
      "mode": "brokered",
      "runner": "copilot-cli",
      "model": "gpt-6-luna",
      "needs": [
        {
          "stage": "patterns",
          "output": "findings"
        }
      ],
      "after": [
        "secrets"
      ],
      "fanOut": "per-run",
      "budget": {
        "turns": 3,
        "tokens": 20000,
        "seconds": 120
      }
    },
    {
      "id": "report",
      "kind": "builtin",
      "operation": "report",
      "needs": [
        "secrets",
        "patterns",
        "review"
      ]
    }
  ],
  "flags": {
    "review.hosted-api": false
  }
}
